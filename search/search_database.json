nt64 )), 1_int64 )) r = int ( u64_add ( int ( lo , int64 ), splitmix64_uniform_below ( gen , span_minus_1 )), default_int ) end function splitmix64_next_range","tags":"","url":"proc/splitmix64_next_range.html"},{"title":"splitmix64_uniform_below – PIC","text":"private  function splitmix64_uniform_below(gen, span_minus_1) result(r) Uniform unsigned integer in [0, span_minus_1] , by rejection. Arguments Type Intent Optional Attributes Name type( splitmix64_t ), intent(inout) :: gen integer(kind=int64), intent(in) :: span_minus_1 Inclusive upper bound, read as unsigned. Return Value integer(kind=int64) Calls proc~~splitmix64_uniform_below~~CallsGraph proc~splitmix64_uniform_below splitmix64_uniform_below proc~rejection_mask~2 rejection_mask proc~splitmix64_uniform_below->proc~rejection_mask~2 proc~splitmix64_next_u64 splitmix64_t%splitmix64_next_u64 proc~splitmix64_uniform_below->proc~splitmix64_next_u64 proc~u64_less u64_less proc~splitmix64_uniform_below->proc~u64_less proc~u64_shr u64_shr proc~rejection_mask~2->proc~u64_shr proc~splitmix64_next splitmix64_t%splitmix64_next proc~splitmix64_next_u64->proc~splitmix64_next proc~mix64 mix64 proc~splitmix64_next->proc~mix64 proc~u64_add u64_add proc~splitmix64_next->proc~u64_add proc~mix64->proc~u64_shr proc~u64_mul u64_mul proc~mix64->proc~u64_mul Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~splitmix64_uniform_below~~CalledByGraph proc~splitmix64_uniform_below splitmix64_uniform_below proc~splitmix64_next_bernoulli_ppm splitmix64_next_bernoulli_ppm proc~splitmix64_next_bernoulli_ppm->proc~splitmix64_uniform_below proc~splitmix64_next_range splitmix64_next_range proc~splitmix64_next_range->proc~splitmix64_uniform_below interface~next_bernoulli_ppm next_bernoulli_ppm interface~next_bernoulli_ppm->proc~splitmix64_next_bernoulli_ppm interface~next_range next_range interface~next_range->proc~splitmix64_next_range Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=int64), private :: mask Source Code function splitmix64_uniform_below ( gen , span_minus_1 ) result ( r ) !! Uniform unsigned integer in `[0, span_minus_1]`, by rejection. type ( splitmix64_t ), intent ( inout ) :: gen integer ( int64 ), intent ( in ) :: span_minus_1 !! Inclusive upper bound, read as unsigned. integer ( int64 ) :: r integer ( int64 ) :: mask if ( span_minus_1 == 0_int64 ) then r = 0_int64 return end if mask = rejection_mask ( span_minus_1 ) do r = iand ( gen % next_u64 (), mask ) if (. not . u64_less ( span_minus_1 , r )) exit end do end function splitmix64_uniform_below","tags":"","url":"proc/splitmix64_uniform_below.html"},{"title":"next_bernoulli_ppm – PIC","text":"public interface next_bernoulli_ppm Return true with probability ppm in a million. ppm is clamped to [0, PPM_ONE] , so 0 never fires and 1000000\nalways does, and no value in between can be mistyped into an error.\nParts per million rather than a real probability because this reaches\nsimulation state: an incident either happened or it did not, and two\nruns must agree on which. Calls interface~~next_bernoulli_ppm~~CallsGraph interface~next_bernoulli_ppm next_bernoulli_ppm proc~pcg32_next_bernoulli_ppm pcg32_next_bernoulli_ppm interface~next_bernoulli_ppm->proc~pcg32_next_bernoulli_ppm proc~splitmix64_next_bernoulli_ppm splitmix64_next_bernoulli_ppm interface~next_bernoulli_ppm->proc~splitmix64_next_bernoulli_ppm proc~pcg32_uniform_below pcg32_uniform_below proc~pcg32_next_bernoulli_ppm->proc~pcg32_uniform_below proc~splitmix64_uniform_below splitmix64_uniform_below proc~splitmix64_next_bernoulli_ppm->proc~splitmix64_uniform_below proc~pcg32_next_u64 pcg32_t%pcg32_next_u64 proc~pcg32_uniform_below->proc~pcg32_next_u64 proc~rejection_mask~2 rejection_mask proc~pcg32_uniform_below->proc~rejection_mask~2 proc~u64_less u64_less proc~pcg32_uniform_below->proc~u64_less proc~splitmix64_uniform_below->proc~rejection_mask~2 proc~splitmix64_next_u64 splitmix64_t%splitmix64_next_u64 proc~splitmix64_uniform_below->proc~splitmix64_next_u64 proc~splitmix64_uniform_below->proc~u64_less proc~pcg32_step pcg32_step proc~pcg32_next_u64->proc~pcg32_step proc~u64_shr u64_shr proc~rejection_mask~2->proc~u64_shr proc~splitmix64_next splitmix64_t%splitmix64_next proc~splitmix64_next_u64->proc~splitmix64_next proc~pcg32_step->proc~u64_shr proc~rotate_right32 rotate_right32 proc~pcg32_step->proc~rotate_right32 proc~u64_add u64_add proc~pcg32_step->proc~u64_add proc~u64_mul u64_mul proc~pcg32_step->proc~u64_mul proc~mix64 mix64 proc~splitmix64_next->proc~mix64 proc~splitmix64_next->proc~u64_add Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Module Procedures private  function splitmix64_next_bernoulli_ppm (gen, ppm) result(r) True with probability ppm in a million, from a splitmix64_t generator. Arguments Type Intent Optional Attributes Name type( splitmix64_t ), intent(inout) :: gen Generator, advanced by the draw unless ppm is 0 or PPM_ONE . integer(kind=default_int), intent(in) :: ppm Probability in parts per million, clamped to [0, PPM_ONE] . Return Value logical private  function pcg32_next_bernoulli_ppm (gen, ppm) result(r) True with probability ppm in a million, from a pcg32_t generator. Arguments Type Intent Optional Attributes Name type( pcg32_t ), intent(inout) :: gen Generator, advanced by the draw unless ppm is 0 or PPM_ONE . integer(kind=default_int), intent(in) :: ppm Probability in parts per million, clamped to [0, PPM_ONE] . Return Value logical","tags":"","url":"interface/next_bernoulli_ppm.html"},{"title":"next_exponential_int – PIC","text":"public interface next_exponential_int Draw an exponentially distributed integer with the given mean, in\nwhatever unit mean is expressed in. Sampling is a table lookup and two integer multiplies. EXP_TABLE holds the inverse CDF -ln(1 - k/4096) in Q32.32 fixed point,\ngenerated once by tools/autogen/gen_exp_table.py with 60-digit\ndecimal arithmetic. Twelve random bits choose a cell, thirty-one more\ninterpolate linearly inside it, and the result is scaled by mean . The tail The top cell runs to infinity and cannot be interpolated into. It is\nhandled with the memorylessness of the exponential instead: if U is\nuniform on the top cell then -ln(1 - U) is distributed as ln(4096) plus a fresh exponential, so the sampler adds ln(4096) and draws again. That is exact, and it costs an extra draw with\nprobability 1/4096. Capping the top entry at a finite value and interpolating into it –\nthe obvious alternative – biases the mean by 0.147%. This scheme\nleaves 0.002%, and all of that residue is linear interpolation inside\nthe body cells, not the tail. mean must be in [0, EXPONENTIAL_MAX_MEAN] . A mean of zero always\nreturns zero without consuming a draw. Out of range returns zero and,\nif err is present, sets ERROR_VALIDATION . Calls interface~~next_exponential_int~~CallsGraph interface~next_exponential_int next_exponential_int proc~pcg32_next_exponential_int pcg32_next_exponential_int interface~next_exponential_int->proc~pcg32_next_exponential_int proc~splitmix64_next_exponential_int splitmix64_next_exponential_int interface~next_exponential_int->proc~splitmix64_next_exponential_int proc~error_set error_t%error_set proc~pcg32_next_exponential_int->proc~error_set proc~pcg32_next_u64 pcg32_t%pcg32_next_u64 proc~pcg32_next_exponential_int->proc~pcg32_next_u64 proc~scale_by_mean scale_by_mean proc~pcg32_next_exponential_int->proc~scale_by_mean proc~u64_shr u64_shr proc~pcg32_next_exponential_int->proc~u64_shr proc~splitmix64_next_exponential_int->proc~error_set proc~splitmix64_next_exponential_int->proc~scale_by_mean proc~splitmix64_next_u64 splitmix64_t%splitmix64_next_u64 proc~splitmix64_next_exponential_int->proc~splitmix64_next_u64 proc~splitmix64_next_exponential_int->proc~u64_shr proc~pcg32_step pcg32_step proc~pcg32_next_u64->proc~pcg32_step proc~scale_by_mean->proc~u64_shr proc~splitmix64_next splitmix64_t%splitmix64_next proc~splitmix64_next_u64->proc~splitmix64_next proc~pcg32_step->proc~u64_shr proc~rotate_right32 rotate_right32 proc~pcg32_step->proc