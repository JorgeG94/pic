, integer(int64) values. Default initialisation yields a valid empty map; the first insert allocates with default capacity if init was never called. Components Type Visibility Attributes Name Initial integer(kind=default_int), private, allocatable :: buckets (:) Bucket table; BUCKET_EMPTY or an index into the entry table. integer(kind=default_int), private :: entry_cap = 0 Allocated length of the entry arrays. integer(kind=int64), private, allocatable :: entry_value (:) Value of each entry, in insertion order. character(len=1), private, allocatable :: key_pool (:) Packed storage for all key characters. integer(kind=default_int), private, allocatable :: key_size (:) Length in characters of each key, in insertion order. integer(kind=default_int), private, allocatable :: key_start (:) First character of each key inside key_pool , in insertion order. integer(kind=default_int), private :: n_buckets = 0 Number of buckets, always a power of two, 0 while unallocated. integer(kind=default_int), private :: n_entries = 0 Number of live entries, i.e. the value returned by size() . integer(kind=default_int), private :: pool_cap = 0 Allocated length of key_pool . integer(kind=default_int), private :: pool_used = 0 Number of characters currently used in key_pool . Type-Bound Procedures procedure, public :: at => hash_map_at procedure, public :: bucket_count => hash_map_bucket_count procedure, public :: clear => hash_map_clear procedure, public :: destroy => hash_map_destroy procedure, public :: get => hash_map_get procedure, public :: has_key => hash_map_has_key procedure, public :: init => hash_map_init procedure, public :: insert => hash_map_insert procedure, public :: is_empty => hash_map_is_empty procedure, public :: keys => hash_map_keys procedure, public :: remove => hash_map_remove procedure, public :: size => hash_map_size procedure, public :: values => hash_map_values Functions private  function entry_key (this, entry) result(key) Rebuild the key of an entry from the packed character pool. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this integer(kind=default_int), intent(in) :: entry Return Value character(len=:), allocatable private  function find_entry (this, key) result(entry) Index of key in the insertion-order table, or 0 when absent. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this character(len=*), intent(in) :: key Return Value integer(kind=default_int) private pure function hash_map_bucket_count (this) result(n) Current number of buckets, 0 while the map is unallocated. Exposed so\nthat callers and tests can observe growth; it never affects iteration\norder. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value integer(kind=default_int) private  function hash_map_has_key (this, key) result(present_in_map) .true. when key is stored in the map. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this character(len=*), intent(in) :: key Return Value logical private pure function hash_map_is_empty (this) result(empty) .true. when the map holds no entries. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value logical private  function hash_map_keys (this) result(res) All keys, in insertion order. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value character(len=:), allocatable, (:) private pure function hash_map_size (this) result(n) Number of entries currently stored. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value integer(kind=default_int) private  function hash_map_values (this) result(res) All values, in insertion order. values() and keys() are index\naligned: values(i) belongs to keys(i) . Zero-sized for an empty\nmap. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value integer(kind=int64), allocatable, (:) private  function home_bucket (this, key) result(bucket) Bucket a key hashes to before probing. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this character(len=*), intent(in) :: key Return Value integer(kind=default_int) private  function key_matches (this, entry, key) result(same) Exact key comparison: same length and same characters. Deliberately\nnot the Fortran == operator, which blank-pads the shorter operand. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this integer(kind=default_int), intent(in) :: entry character(len=*), intent(in) :: key Return Value logical private  function probe_free (this, key) result(bucket) First empty bucket in the probe sequence of key . The load factor\nkeeps at least one bucket empty at all times, so this always finds\none. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this character(len=*), intent(in) :: key Return Value integer(kind=default_int) Subroutines private  subroutine grow_buckets (this) Double the bucket table and rehash. Entry storage is never moved. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this private  subroutine hash_map_at (this, position, key, value, err) Fetch the entry at position in the iteration order, counting from 1.\nThis is the exact-fidelity iteration accessor: key comes back with\nthe key’s true length, trailing blanks included. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this integer(kind=default_int), intent(in) :: position character(len=:), intent(out), allocatable :: key integer(kind=int64), intent(out) :: value type( error_t ), intent(out), optional :: err private  subroutine hash_map_clear (this) Remove every entry but keep the allocated capacity, so that refilling\nthe map does not have to reallocate. A cleared map iterates as empty\nand the next insert starts a fresh insertion order at position 1. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this private  subroutine hash_map_destroy (this) Release every buffer and return the map to the unallocated state. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this private  subroutine hash_map_get (this, key, value, found) Look up key . A missing key is an ordinary outcome, not an error: found comes back .false. and value is set to 0. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this character(len=*), intent(in) :: key integer(kind=int64), intent(out) :: value logical, intent(out) :: found private  subroutine hash_map_init (this, initial_capacity) Allocate the map, discarding any entries it already held. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this integer(kind=default_int), intent(in), optional :: initial_capacity private  subroutine hash_map_insert (this, key, value) Insert key with value , or overwrite the value of an existing key. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this character(len=*), intent(in) :: key Stored verbatim; trailing blanks are part of the key. integer(kind=int64), intent(in) :: value private  subroutine hash_map_remove (this, key, err) Remove key from the map. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this character(len=*), intent(in) :: key type( error_t ), intent(out), optional :: err private  subroutine rebuild_buckets (this) Re-index every entry into the bucket table. Touches buckets only, so\nthe insertion order is untouched by construction. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this private  subroutine reserve_entries (this, needed) Ensure the insertion-order arrays hold at least needed entries.\nExplicit allocate/copy/ move_alloc rather than\nreallocation-on-assignment, which is shaky on some supported\ncompilers. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this integer(kind=default_int), intent(in) :: needed private  subroutine reserve_pool (this, needed) Ensure the packed key pool holds at least needed characters. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this integer(kind=default_int), intent(in) :: needed","tags":"","url":"module/pic_hash_map.html"},{"title":"pic_soa_particle – PIC","text":"A struct-of-arrays container holding 6 parallel field arrays. Each field is a separate contiguous rank-1 array, which is the point of\nthe layout: this%id is contiguous, and so is the live slice this%id(1:this%size()) , so either can be handed straight to BLAS or\nto a vectorised loop without a copy. Growth, the serialized record layout, the schema check on deserialize and\nthe state-hash fold order are all documented in pic_soa . This type’s\nschema string is particle;id:i32,x:r64,y:r64,z:r64,mass:r64,active:bool prefixed by SOA_SCHEMA_PREFIX . Fields are serialized and folded into\nthe hash in exactly the order they are declared below. Uses pic_array_hash pic_soa pic_types pic_error module~~pic_soa_particle~~UsesGraph module~pic_soa_particle pic_soa_particle module~pic_array_hash pic_array_hash module~pic_soa_particle->module~pic_array_hash module~pic_error pic_error module~pic_soa_particle->module~pic_error module~pic_soa pic_soa module~pic_soa_particle->module~pic_soa module~pic_types pic_types module~pic_soa_particle->module~pic_types module~pic_array_hash->module~pic_types module~pic_uint64 pic_uint64 module~pic_array_hash->module~pic_uint64 module~pic_error->module~pic_types module~pic_global_definitions pic_global_definitions module~pic_error->module~pic_global_definitions module~pic_soa->module~pic_array_hash module~pic_soa->module~pic_error module~pic_soa->module~pic_types module~pic_io pic_io module~pic_soa->module~pic_io module~pic_serialize pic_serialize module~pic_soa->module~pic_serialize iso_c_binding iso_c_binding module~pic_types->iso_c_binding iso_fortran_env iso_fortran_env module~pic_types->iso_fortran_env module~pic_global_definitions->module~pic_types module~pic_io->module~pic_types module~pic_ascii pic_ascii module~pic_io->module~pic_ascii module~pic_serialize->module~pic_error module~pic_serialize->module~pic_types module~pic_serialize->module~pic_io module~pic_uint64->module~pic_types module~pic_ascii->module~pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: PARTICLE_SOA_FIELD_KINDS (PARTICLE_SOA_N_FIELDS) = [SOA_FIELD_INT32, SOA_FIELD_REAL_DP, SOA_FIELD_REAL_DP, SOA_FIELD_REAL_DP, SOA_FIELD_REAL_DP, SOA_FIELD_LOGICAL] Field kind codes in declaration order. Fixed-width int32 because\nthese describe on-disk record tags. Pass to soa_stream_bytes . integer(kind=default_int), public, parameter :: PARTICLE_SOA_N_FIELDS = 6 Number of fields, which is also the number of field records a stream\ncarries after the prologue. character(len=*), public, parameter :: PARTICLE_SOA_SCHEMA = SOA_SCHEMA_PREFIX//\"particle;id:i32,x:r64,y:r64,z:r64,mass:r64,active:bool\" Layout identity written into every stream and folded into every\ndigest. Any change to the field list changes it, which is what makes a\nstale checkpoint fail loudly instead of decoding as garbage. Derived Types type, public :: particle_soa_t 6 parallel field arrays plus size/capacity bookkeeping. Components Type Visibility Attributes Name Initial logical, public, allocatable :: active (:) Whether the particle takes part in the simulation. type( soa_extent_t ), public :: extent Live element count and allocated capacity. integer(kind=int32), public, allocatable :: id (:) Particle identifier. real(kind=dp), public, allocatable :: mass (:) Particle mass. real(kind=dp), public, allocatable :: x (:) Cartesian x coordinate. real(kind=dp), public, allocatable :: y (:) Cartesian y coordinate. real(kind=dp), public, allocatable :: z (:) Cartesian z coordinate. Type-Bound Procedures procedure, public :: allocate => particle_soa_allocate procedure, public :: capacity => particle_soa_capacity procedure, public :: clear => particle_soa_clear procedure, public :: deallocate => particle_soa_deallocate procedure, public :: deserialize => particle_soa_deserialize procedure, public :: resize => particle_soa_resize procedure, public :: serialize => particle_soa_serialize procedure, public :: serialized_bytes => particle_soa_serialized_bytes procedure, public :: size => particle_soa_size procedure, public :: state_hash => particle_soa_state_hash procedure, public :: state_hash64 => particle_soa_state_hash64 Functions private pure function particle_soa_capacity (this) result(n) Allocated length of every field array. Always at least size() . Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to query. Return Value integer(kind=default_int) private pure function particle_soa_serialized_bytes (this) result(nbytes) Exact size in bytes of the stream serialize would write now. Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to measure. Return Value integer(kind=int64) private pure function particle_soa_size (this) result(n) Number of live elements. Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to query. Return Value integer(kind=default_int) private  function particle_soa_state_hash (this) result(digest) 32-bit FNV-1a digest of the container’s live state. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to fingerprint. Return Value integer(kind=int32) private  function particle_soa_state_hash64 (this) result(digest) 64-bit FNV-1a digest of the container’s live state. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to fingerprint. Return Value integer(kind=int64) Subroutines private  subroutine particle_soa_allocate (this, n, err) Give the container n live elements, discarding any it already had. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to (re)allocate. integer(kind=default_int), intent(in) :: n Number of live elements. Must not be negative. type( error_t ), intent(inout) :: err Error state, ERROR_VALIDATION on a negative n and ERROR_ALLOC if the field arrays cannot be allocated. private  subroutine particle_soa_clear (this) Drop every live element but keep the allocated capacity. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to empty. private  subroutine particle_soa_deallocate (this) Release every field array and reset both counters to zero. Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to empty. private  subroutine particle_soa_deserialize (this, unit, err) Read a container back from an open stream unit. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to fill. Any previous contents are discarded. integer(kind=default_int), intent(in) :: unit Stream unit opened for unformatted stream reading. type( error_t ), intent(inout) :: err Error state, ERROR_VALIDATION on a layout or length mismatch and ERROR_IO on a truncated stream. private  subroutine particle_soa_resize (this, n, err) Change the number of live elements, preserving the elements that\nsurvive. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to resize. integer(kind=default_int), intent(in) :: n New number of live elements. Must not be negative. type( error_t ), intent(inout) :: err Error state, ERROR_VALIDATION on a negative n and ERROR_ALLOC if a field array cannot be allocated. private  subroutine particle_soa_serialize (this, unit, err) Write the container to an open stream unit. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to write. integer(kind=default_int), intent(in) :: unit Stream unit opened for unformatted stream writing. type( error_t ), intent(inout) :: err Error state, ERROR_IO if the stream cannot be written.","tags":"","url":"module/pic_soa_particle.html"},{"title":"pic_ansi – PIC","text":"The half of a terminal interface that is pure string processing. Nothing here does any I/O, opens anything, or asks the operating system\na question. Every escape builder is a pure function returning a\nstring, the key decoder is a pure subroutine over a byte array, and\nthe frame composer hands back one string for the caller to write. The\nparts that must talk to the OS – raw mode, terminal size, reading with\na timeout – live in pic_term . That split is what makes this testable: every case below is exercised\nwithout a terminal, because there is nothing here that needs one. Quick start use pic_ansi type ( frame_t ) :: frame type ( key_event_t ) :: events ( 16 ) integer ( default_int ) :: n write ( * , \"(a)\" , advance = \"no\" ) ansi_alt_screen_enter () // ansi_hide_cursor () call frame % resize ( 24_default_int , 80_default_int ) call frame % set_line ( 1_default_int , styled ( \"ARRIVALS\" , fg = ANSI_CYAN , bold = . true .)) write ( * , \"(a)\" , advance = \"no\" ) frame % render () call decode_keys ( pending , raw_bytes , events , n ) Width is counted in code points set_line truncates to the frame width in UTF-8 code points, not bytes,\nso a row of box-drawing characters – three bytes each, one column each\n– is not cut a third of the way along. East Asian wide characters, and\ncombining marks, still count as one column each; getting those right\nneeds a character-width table and is out of scope here. Uses pic_strings pic_string_type pic_types module~~pic_ansi~~UsesGraph module~pic_ansi pic_ansi module~pic_string_type pic_string_type module~pic_ansi->module~pic_string_type module~pic_strings pic_strings module~pic_ansi->module~pic_strings module~pic_types pic_types module~pic_ansi->module~pic_types module~pic_string_type->module~pic_types module~pic_ascii pic_ascii module~pic_string_type->module~pic_ascii module~pic_optional_value pic_optional_value module~pic_string_type->module~pic_optional_value module~pic_strings->module~pic_string_type module~pic_strings->module~pic_types iso_c_binding iso_c_binding module~pic_strings->iso_c_binding module~pic_strings->module~pic_ascii module~pic_strings->module~pic_optional_value module~pic_types->iso_c_binding iso_fortran_env iso_fortran_env module~pic_types->iso_fortran_env module~pic_ascii->module~pic_types module~pic_optional_value->module~pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: ANSI_BLACK = 0_int32 integer(kind=int32), public, parameter :: ANSI_BLUE = 4_int32 integer(kind=int32), public, parameter :: ANSI_BRIGHT_BLACK = 8_int32 integer(kind=int32), public, parameter :: ANSI_BRIGHT_BLUE = 12_int32 integer(kind=int32), public, parameter :: ANSI_BRIGHT_CYAN = 14_int32 integer(kind=int32), public, parameter :: ANSI_BRIGHT_GREEN = 10_int32 integer(kind=int32), public, parameter :: ANSI_BRIGHT_MAGENTA = 13_int32 integer(kind=int32), public, parameter :: ANSI_BRIGHT_RED = 9_int32 integer(kind=int32), public, parameter :: ANSI_BRIGHT_WHITE = 15_int32 The sixteen named colours. 0-7 are the normal set, 8-15 the bright\nset, which is why ansi_fg splits at 8 rather than taking two\nseparate entry points. integer(kind=int32), public, parameter :: ANSI_BRIGHT_YELLOW = 11_int32 integer(kind=int32), public, parameter :: ANSI_CYAN = 6_int32 integer(kind=int32), public, parameter :: ANSI_GREEN = 2_int32 integer(kind=int32), public, parameter :: ANSI_MAGENTA = 5_int32 integer(kind=int32), public, parameter :: ANSI_RED = 1_int32 integer(kind=int32), public, parameter :: ANSI_WHITE = 7_int32 integer(kind=int32), public, parameter :: ANSI_YELLOW = 3_int32 character(len=*), public, parameter :: ESC = achar(27) The escape character, 0x1B. integer(kind=int32), public, parameter :: KEY_BACKSPACE = 3_int32 integer(kind=int32), public, parameter :: KEY_CHAR = 1_int32 A printable byte; char_code holds it. integer(kind=int32), public, parameter :: KEY_CTRL_C = 13_int32 integer(kind=int32), public, parameter :: KEY_DELETE = 12_int32 integer(kind=int32), public, parameter :: KEY_DOWN = 7_int32 integer(kind=int32), public, parameter :: KEY_END = 11_int32 integer(kind=int32), public, parameter :: KEY_ENTER = 2_int32 integer(kind=int32), public, parameter :: KEY_ESC = 5_int32 integer(kind=int32), public, parameter :: KEY_HOME = 10_int32 integer(kind=int32), public, parameter :: KEY_LEFT = 9_int32 integer(kind=int32), public, parameter :: KEY_NONE = 0_int32 No event. A key_event_t starts here. integer(kind=int32), public, parameter :: KEY_RIGHT = 8_int32 integer(kind=int32), public, parameter :: KEY_TAB = 4_int32 integer(kind=int32), public, parameter :: KEY_UP = 6_int32 integer(kind=default_int), public, parameter :: PENDING_CAPACITY = 16_default_int Longest partial escape sequence carried between reads. The sequences\nrecognised here are at most six bytes; the rest is slack so that a\nhostile or unknown sequence cannot overrun the buffer. character(len=*), private, parameter :: CSI = ESC//\"[\" Control Sequence Introducer. Derived Types type, public :: frame_t A screen’s worth of text lines, rendered by diffing against the last. Read more… Components Type Visibility Attributes Name Initial integer(kind=default_int), private :: cols = 0_default_int Width in code points; set_line truncates to it. type( string_type ), private, allocatable :: current (:) Lines as set since the last render. Read more… logical, private :: full_redraw = .true. Set by resize and invalidate ; makes the next render emit every\nrow regardless of the diff. integer(kind=default_int), private :: rows = 0_default_int Number of lines. type( string_type ), private, allocatable :: shown (:) Lines as of the last render, for diffing. Type-Bound Procedures procedure, public :: col_count => frame_col_count procedure, public :: invalidate => frame_invalidate procedure, public :: render => frame_render procedure, public :: resize => frame_resize procedure, public :: row_count => frame_row_count procedure, public :: set_line => frame_set_line type, public :: key_event_t One decoded key press. Components Type Visibility Attributes Name Initial integer(kind=int32), public :: char_code = 0_int32 Byte value, meaningful when code is KEY_CHAR . integer(kind=int32), public :: code = KEY_NONE One of the KEY_* codes. type, public :: pending_t Bytes of an escape sequence that arrived without their continuation. Read more… Components Type Visibility Attributes Name Initial character(len=PENDING_CAPACITY), private :: buffer = \"\" Fixed store, so a pending_t needs no allocation and can be a\nplain component of a caller’s state. integer(kind=default_int), private :: length = 0_default_int Bytes in use. Type-Bound Procedures procedure, public :: clear => pending_clear procedure, public :: is_empty => pending_is_empty Functions public pure function ansi_alt_screen_enter () result(seq) Switch to the alternate screen buffer. Read more… Arguments None Return Value character(len=:), allocatable public pure function ansi_alt_screen_leave () result(seq) Switch back to the normal screen buffer. Arguments None Return Value character(len=:), allocatable public pure function ansi_bg (color) result(seq) Set the background to one of the sixteen named colours. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: color One of the ANSI_* colour constants, 0 to 15. Return Value character(len=:), allocatable public pure function ansi_bg_256 (index) result(seq) Set the background from the 256-colour cube. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: index Palette index, clamped to 0 to 255. Return Value character(len=:), allocatable public pure function ansi_bg_rgb (r, g, b) result(seq) Set the background to a 24-bit colour. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: r Red, clamped to 0 to 255. integer(kind=int32), intent(in) :: g Green, clamped to 0 to 255. integer(kind=int32), intent(in) :: b Blue, clamped to 0 to 255. Return Value character(len=:), allocatable public pure function ansi_bold () result(seq) Turn on bold. Arguments None Return Value character(len=:), allocatable public pure function ansi_clear_line () result(seq) Clear the line the cursor is on. Arguments None Return Value character(len=:), allocatable public pure function ansi_clear_screen () result(seq) Clear the whole screen and home the cursor. Arguments None Return Value character(len=:), allocatable public pure function ansi_fg (color) result(seq) Set the foreground to one of the sixteen named colours. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: color One of the ANSI_* colour constants, 0 to 15. Return Value character(len=:), allocatable public pure function ansi_fg_256 (index) result(seq) Set the foreground from the 256-colour cube. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: index Palette index, clamped to 0 to 255. Return Value character(len=:), allocatable public pure function ansi_fg_rgb (r, g, b) result(seq) Set the foreground to a 24-bit colour. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: r Red, clamped to 0 to 255. integer(kind=int32), intent(in) :: g Green, clamped to 0 to 255. integer(kind=int32), intent(in) :: b Blue, clamped to 0 to 255. Return Value character(len=:), allocatable public pure function ansi_hide_cursor () result(seq) Hide the cursor. Arguments None Return Value character(len=:), allocatable public pure function ansi_move_to (row, col) result(seq) Move the cursor to a one-based row and column. Read more… Arguments Type Intent Optional Attributes Name integer(kind=default_int), intent(in) :: row One-based row; values below 1 are clamped to 1. integer(kind=default_int), intent(in) :: col One-based column; values below 1 are clamped to 1. Return Value character(len=:), allocatable public pure function ansi_reset () result(seq) Reset every attribute. Arguments None Return Value character(len=:), allocatable public pure function ansi_reverse () result(seq) Swap foreground and background. Arguments None Return Value character(len=:), allocatable public pure function ansi_show_cursor () result(seq) Show the cursor. Arguments None Return Value character(len=:), allocatable public pure function display_width (text) result(width) Number of columns text occupies. Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text Text to