s !! still come back as the NumPy defaults select case ( trim ( to_upper ( adjustl ( format_type )))) case ( \"NUMPY\" ) open_bracket = \"[\" close_bracket = \"]\" case ( \"MATHEMATICA\" ) open_bracket = \"{\" close_bracket = \"}\" case ( \"PLAIN\" ) open_bracket = \"[\" close_bracket = \"]\" case default if ( present ( err )) then call error_raise ( err , ERROR_VALIDATION , \"pic_print_array: unsupported format type '\" // trim ( format_type ) // \"'\" ) else print * , \"Warning: Unsupported format type '\" // trim ( format_type ) // \"'. Defaulting to NumPy style.\" end if open_bracket = \"[\" close_bracket = \"]\" end select end subroutine set_brackets subroutine fill_vector_int32 ( vector , alpha , threaded ) !! fill a vector of datatype int32 with a value integer ( int32 ), intent ( inout ) :: vector (:) integer ( int32 ), intent ( in ) :: alpha logical , intent ( in ), optional :: threaded logical :: use_threads integer ( default_int ) :: i use_threads = pic_optional ( threaded , use_threaded_default ) if ( use_threads ) then !$omp parallel do collapse(1) private(i) do i = 1 , size ( vector , 1 ) vector ( i ) = alpha end do !$omp end parallel do else vector = alpha end if end subroutine fill_vector_int32 subroutine fill_vector_int64 ( vector , alpha , threaded ) !! fill a vector of datatype int64 with a value integer ( int64 ), intent ( inout ) :: vector (:) integer ( int64 ), intent ( in ) :: alpha logical , intent ( in ), optional :: threaded logical :: use_threads integer ( default_int ) :: i use_threads = pic_optional ( threaded , use_threaded_default ) if ( use_threads ) then !$omp parallel do collapse(1) private(i) do i = 1 , size ( vector , 1 ) vector ( i ) = alpha end do !$omp end parallel do else vector = alpha end if end subroutine fill_vector_int64 subroutine fill_vector_sp ( vector , alpha , threaded ) !! fill a vector of datatype sp with a value real ( sp ), intent ( inout ) :: vector (:) real ( sp ), intent ( in ) :: alpha logical , intent ( in )