ode pure function to_string_fixed_sp ( value , decimals ) result ( string ) !! Fixed point rendering of a `real(sp)` value. !! !! Widening to `real(dp)` is exact for every finite `real(sp)` value and !! preserves NaN and both infinities, so the double precision expansion !! produces the same digits. real ( sp ), intent ( in ) :: value integer ( default_int ), intent ( in ) :: decimals character ( len = :), allocatable :: string string = to_string_fixed_dp ( real ( value , dp ), decimals ) end function to_string_fixed_sp","tags":"","url":"proc/to_string_fixed_sp.html"},{"title":"to_string_sci_dp – PIC","text":"private pure function to_string_sci_dp(value, sig_digits) result(string) Scientific rendering of a real(dp) value. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: value integer(kind=default_int), intent(in) :: sig_digits Return Value character(len=:), allocatable Calls proc~~to_string_sci_dp~~CallsGraph proc~to_string_sci_dp to_string_sci_dp proc~expand_exact expand_exact proc~to_string_sci_dp->proc~expand_exact proc~exponent_field exponent_field proc~to_string_sci_dp->proc~exponent_field proc~is_negative is_negative proc~to_string_sci_dp->proc~is_negative proc~round_decimal round_decimal proc~to_string_sci_dp->proc~round_decimal proc~special_text special_text proc~to_string_sci_dp->proc~special_text proc~bd_mul_pow bd_mul_pow proc~expand_exact->proc~bd_mul_pow proc~bd_set bd_set proc~expand_exact->proc~bd_set proc~bd_to_digits bd_to_digits proc~expand_exact->proc~bd_to_digits interface~to_string to_string proc~exponent_field->interface~to_string proc~increment_digits increment_digits proc~round_decimal->proc~increment_digits proc~bd_mul_small bd_mul_small proc~bd_mul_pow->proc~bd_mul_small proc~limb_to_digits limb_to_digits proc~bd_to_digits->proc~limb_to_digits Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~to_string_sci_dp~~CalledByGraph proc~to_string_sci_dp to_string_sci_dp interface~to_string_sci to_string_sci interface~to_string_sci->proc~to_string_sci_dp proc~to_string_sci_sp to_string_sci_sp interface~to_string_sci->proc~to_string_sci_sp proc~to_string_sci_sp->proc~to_string_sci_dp Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=default_int), private :: bump character(len=WORK_LEN), private :: exact integer(kind=default_int), private :: exp10 integer(kind=default_int), private :: n_exact integer(kind=default_int), private :: n_rounded logical, private :: negative integer(kind=default_int), private :: point_pos character(len=WORK_LEN), private :: rounded integer(kind=default_int), private :: sig logical, private :: special Source Code pure function to_string_sci_dp ( value , sig_digits ) result ( string ) !! Scientific rendering of a `real(dp)` value. real ( dp ), intent ( in ) :: value integer ( default_int ), intent ( in ) :: sig_digits character ( len = :), allocatable :: string character ( len = WORK_LEN ) :: exact , rounded integer ( default_int ) :: n_exact , point_pos , sig , n_rounded , bump , exp10 logical :: negative , special call special_text ( value , string , special ) if ( special ) return sig = max ( 1_default_int , min ( sig_digits , PIC_FORMAT_MAX_SIG_DIGITS )) negative = is_negative ( value ) if ( value == 0.0_dp ) then ! Zero never carries a sign. Recognising a negative zero requires SIGN ! to distinguish the two signed zeros, which Fortran leaves processor ! dependent (F2018 16.9.165: the result is |A| if the processor cannot ! distinguish them), and Intel and AOCC do not distinguish them under ! their default fast floating point model. Emitting \"-0.00\" would ! therefore be compiler dependent, which is the one thing this module ! exists to avoid. A non-zero value that merely rounds to zero does ! keep its sign: SIGN is well defined for a non-zero argument. negative = . false . rounded = repeat ( \"0\" , sig ) exp10 = 0_default_int else call expand_exact ( abs ( value ), exact , n_exact , point_pos ) call round_decimal ( exact , n_exact , sig , rounded , n_rounded , bump ) ! A carry out of the leading digit turns \"999\" into \"1000\"; only the ! first sig digits are used, so the extra trailing zero is ignored and ! the decimal exponent moves up by one instead. exp10 = point_pos + bump - 1_default_int end if if ( sig > 1_default_int ) then string = rounded ( 1 : 1 ) // \".\" // rounded ( 2 : sig ) else string = rounded ( 1 : 1 ) end if string = string // \"e\" // exponent_field ( exp10 ) if ( negative ) string = \"-\" // string end function to_string_sci_dp","tags":"","url":"proc/to_string_sci_dp.html"},{"title":"to_string_sci_sp – PIC","text":"private pure function to_string_sci_sp(value, sig_digits