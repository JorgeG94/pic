p can hold before it has to grow. Arguments Type Intent Optional Attributes Name class( heap_t ), intent(in) :: self Return Value integer(kind=default_int) private pure function heap_is_empty (self) result(empty) .true. when the heap holds no entries. Arguments Type Intent Optional Attributes Name class( heap_t ), intent(in) :: self Return Value logical private pure function heap_size (self) result(n) Number of entries currently in the heap. Arguments Type Intent Optional Attributes Name class( heap_t ), intent(in) :: self Return Value integer(kind=default_int) private pure function precedes (self, left, right) result(first) .true. when entry left must pop before entry right . Read more… Arguments Type Intent Optional Attributes Name class( heap_t ), intent(in) :: self integer(kind=default_int), intent(in) :: left integer(kind=default_int), intent(in) :: right Return Value logical private  function root_entry (self, key, payload, err) result(ok) Fetch the root entry, reporting an error when the heap is empty. Arguments Type Intent Optional Attributes Name class( heap_t ), intent(in) :: self integer(kind=int64), intent(out) :: key integer(kind=int32), intent(out) :: payload type( error_t ), intent(out), optional :: err Return Value logical Subroutines private  subroutine grow_int32 (arr, n_keep, new_cap) integer(int32) counterpart of grow_int64 . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), allocatable :: arr (:) integer(kind=default_int), intent(in) :: n_keep integer(kind=default_int), intent(in) :: new_cap private  subroutine grow_int64 (arr, n_keep, new_cap) Reallocate arr to new_cap slots, keeping its first n_keep values. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int64), intent(inout), allocatable :: arr (:) integer(kind=default_int), intent(in) :: n_keep integer(kind=default_int), intent(in) :: new_cap private  subroutine heap_build_from (self, keys, payloads, err) Replace the heap contents with 