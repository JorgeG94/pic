\nthen converted with an F edit descriptor built for the exact field\nwidth. List directed input is avoided on purpose, see the module\ndocumentation. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: str real(kind=dp), intent(out) :: value type( error_t ), intent(out) :: err Calls proc~~parse_real_wide~~CallsGraph proc~parse_real_wide parse_real_wide interface~strip strip proc~parse_real_wide->interface~strip proc~check_exponent check_exponent proc~parse_real_wide->proc~check_exponent proc~error_has_error error_t%error_has_error proc~parse_real_wide->proc~error_has_error proc~error_set error_t%error_set proc~parse_real_wide->proc~error_set proc~skip_sign skip_sign proc~parse_real_wide->proc~skip_sign proc~strip_char strip_char interface~strip->proc~strip_char proc~strip_string strip_string interface~strip->proc~strip_string proc~check_exponent->proc~error_set proc~check_exponent->proc~skip_sign proc~strip_string->interface~strip Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~parse_real_wide~~CalledByGraph proc~parse_real_wide parse_real_wide proc~parse_real_dp_char parse_real_dp_char proc~parse_real_dp_char->proc~parse_real_wide proc~parse_real_dp_string parse_real_dp_string proc~parse_real_dp_string->proc~parse_real_wide proc~parse_real_sp_char parse_real_sp_char proc~parse_real_sp_char->proc~parse_real_wide interface~parse_real parse_real interface~parse_real->proc~parse_real_dp_char interface~parse_real->proc~parse_real_dp_string interface~parse_real->proc~parse_real_sp_char proc~parse_real_sp_string parse_real_sp_string interface~parse_real->proc~parse_real_sp_string proc~parse_real_sp_string->proc~parse_real_sp_char proc~cli_get_real_dp cli_t%cli_get_real_dp proc~cli_get_real_dp->interface~parse_real proc~cli_get_real_sp cli_t%cli_get_real_sp proc~cli_get_real_sp->interface~parse_real Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial character(len=16), private :: field_format integer(kind=default_int), private :: n_digits integer(kind=default_int), private :: pos logical, private :: seen_point integer(kind=int32), private :: stat Fixed width on purpose: iostat takes a default integer, which is int32 regardless of how PIC defines default_int . character(len=:), private, allocatable :: text Source Code subroutine parse_real_wide ( str , value , err ) !! Core real parser. !! !! The string is validated against an explicit grammar first and only !! then converted with an `F` edit descriptor built for the exact field !! width. List directed input is avoided on purpose, see the module !! documentation. character ( len =* ), intent ( in ) :: str real ( dp ), intent ( out ) :: value type ( error_t ), intent ( out ) :: err character ( len = :), allocatable :: text character ( len = 16 ) :: field_format integer ( default_int ) :: pos , n_digits integer ( int32 ) :: stat !! Fixed width on purpose: `iostat` takes a default integer, which is !! `int32` regardless of how PIC defines `default_int`. logical :: seen_point value = 0.0_dp text = strip ( str ) if ( len ( text ) == 0 ) then call err % set ( ERROR_PARSE , \"cannot parse an empty string as a real\" ) return end if pos = 1 call skip_sign ( text , pos ) n_digits = 0 seen_point = . false . do while ( pos <= len ( text )) if ( index ( digits , text ( pos : pos )) > 0 ) then n_digits = n_digits + 1 else if ( text ( pos : pos ) == \".\" . and . . not . seen_point ) then seen_point = . true . else exit end if pos = pos + 1 end do if ( n_digits == 0 ) then call err % set ( ERROR_PARSE , \"no digits in the mantissa of '\" // text // \"'\" ) return end if if ( pos <= len ( text )) then call check_exponent ( text , pos , err ) if ( err % has_error ()) return end if write ( field_format , '(\"(F\",I0,\".0)\")' ) len ( text ) read ( text , field_format , iostat = stat ) value ! A failed read leaves `value` undefined, so make it safe to inspect ! before the range check below looks at it. if ( stat /= 0_int32 ) value = 0.0_dp ! Compilers disagree on what an out of range field does: some report a ! non zero iostat, others quietly deliver an infinity. Reject both. if ( stat /= 0_int32 . or . abs ( value ) > huge ( value )) then value = 0.0_dp call err % set ( ERROR_PARSE , \"real out of range or not convertible: '\" // text // \"'\" ) return end if end subroutine parse_real_wide","tags":"","url":"proc/parse_real_wide.html"},{"title":"skip_sign – PIC","text":"private pure subroutine skip_sign(text, pos) Advance pos past a leading + or - if one is present. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text integer(kind=default_int), intent(inout) :: pos Called by proc~~skip_sign~~CalledByGraph proc~skip_sign skip_sign proc~check_exponent check_exponent proc~check_exponent->proc~skip_sign proc~parse_real_wide parse_real_wide proc~parse_real_wide->proc~skip_sign proc~parse_real_wide->proc~check_exponent proc~parse_real_dp_char parse_real_dp_char proc~parse_real_dp_char->proc~parse_real_wide proc~parse_real_dp_string parse_real_dp_string proc~parse_real_dp_string->proc~parse_real_wide proc~parse_real_sp_char parse_real_sp_char proc~parse_real_sp_char->proc~parse_real_wide interface~parse_real parse_real interface~parse_real->proc~parse_real_dp_char interface~parse_real->proc~parse_real_dp_string interface~parse_real->proc~parse_real_sp_char proc~parse_real_sp_string parse_real_sp_string interface~parse_real->proc~parse_real_sp_string proc~parse_real_sp_string->proc~parse_real_sp_char proc~cli_get_real_dp cli_t%cli_get_real_dp proc~cli_get_real_dp->interface~parse_real proc~cli_get_real_sp cli_t%cli_get_real_sp proc~cli_get_real_sp->interface~parse_real Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine skip_sign ( text , pos ) !! Advance `pos` past a leading `+` or `-` if one is present. character ( len =* ), intent ( in ) :: text integer ( default_int ), intent ( inout ) :: pos if ( pos > len ( text )) return if ( index ( SIGNS , text ( pos : pos )) > 0 ) pos = pos + 1 end subroutine skip_sign","tags":"","url":"proc/skip_sign.html"},{"title":"parse_int – PIC","text":"public interface parse_int Parse a string into an integer, reporting failures through error_t . The accepted grammar is optional surrounding whitespace, an optional + or - sign and one or more decimal digits, with nothing else. An empty\nor blank string, a missing digit, any stray character (including trailing\njunk such as \"12abc\" ) and a value too large for the requested kind all\nset ERROR_PARSE and leave value at zero. Specific procedures exist for int32 and int64 , so an argument\ndeclared integer(default_int) resolves correctly in both the default\nand the USE_INT8 build. Calls interface~~parse_int~~CallsGraph interface~parse_int parse_int proc~parse_int_int32_char parse_int_int32_char interface~parse_int->proc~parse_int_int32_char proc~parse_int_int32_string parse_int_int32_string interface~parse_int->proc~parse_int_int32_string proc~parse_int_int64_char parse_int_int64_char interface~parse_int->proc~parse_int_int64_char proc~parse_int_int64_string parse_int_int64_string interface~parse_int->proc~parse_int_int64_string interface~strip strip proc~parse_int_int32_char->interface~strip proc~error_has_error error_t%error_has_error proc~parse_int_int32_char->proc~error_has_error proc~error_set error_t%error_set proc~parse_int_int32_char->proc~error_set proc~parse_integer_wide parse_integer_wide proc~parse_int_int32_char->proc~parse_integer_wide proc~parse_int_int32_string->proc~parse_int_int32_char proc~parse_int_int64_char->proc~parse_integer_wide proc~parse_int_int64_string->proc~parse_integer_wide proc~strip_char strip_char interface~strip->proc~strip_char proc~strip_string strip_string interface~strip->proc~strip_string proc~parse_integer_wide->interface~strip proc~parse_integer_wide->proc~error_set proc~strip_string->interface~strip Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by interface~~parse_int~~CalledByGraph interface~parse_int parse_int proc~cli_get_int32 cli_t%cli_get_int32 proc~cli_get_int32->interface~parse_int proc~cli_get_int64 cli_t%cli_get_int64 proc~cli_get_int64->interface~parse_int Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Module Procedures private pure subroutine parse_int_int32_char (str, value, err) Parse a character string into a 32 bit integer. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: str integer(kind=int32), intent(out) :: value Fixed width on purpose: the narrow specific procedure of the\ngeneric. type( error_t ), intent(out) :: err private pure subroutine parse_int_int32_string (str, value, err) Parse a string_type into a 32 bit integer. Arguments Type Intent Optional Attributes Name type( string_type ), intent(in) :: str integer(kind=int32), intent(out) :: value type( error_t ), intent(out) :: err private pure subroutine parse_int_int64_char (str, value, err) Parse a character string into a 64 bit integer. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: str integer(kind=int64), intent(out) :: value Fixed width on purpose: this is the widest integer the parser\naccumulates in, and the narrower specific procedure range checks\nagainst it. type( error_t ), intent(out) :: err private pure subroutine parse_int_int64_string (str, value, err) Parse a string_type into a 64 bit integer. Arguments Type Intent Optional Attributes Name type( string_type ), intent(in) :: str integer(kind=int64), intent(out) :: value type( error_t ), intent(out) :: err","tags":"","url":"interface/parse_int.html"},{"title":"parse_real – PIC","text":"public interface parse_real Parse a string into a real, reporting failures through error_t . The accepted grammar is optional surrounding whitespace, an optional\nsign, a mantissa holding at least one digit and at most one decimal point\n(so both \".5\" and \"5.\" are accepted, \".\" is not), and an optional\nexponent introduced by e , E , d or D with an optional sign and at\nleast one digit. Everything else is rejected, in particular the spellings that a list\ndirected read would happily accept: \"nan\" , \"inf\" , \"infinity\" ,\nrepeat counts such as \"3*7\" , comma separated values such as \"1,2\" ,\nand any trailing junk. Values that overflow the requested kind are\nrejected as well instead of becoming infinity. Specific procedures exist for sp and dp . Calls interface~~parse_real~~CallsGraph interface~parse_real parse_real proc~parse_real_dp_char parse_real_dp_char interface~parse_real->proc~parse_real_dp_char proc~parse_real_dp_string parse_real_dp_string interface~parse_real->proc~parse_real_dp_string proc~parse_real_sp_char parse_real_sp_char interface~parse_real->proc~parse_real_sp_char proc~parse_real_sp_string parse_real_sp_stri