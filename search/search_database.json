t ( out ) :: key integer ( int32 ), intent ( out ) :: payload type ( error_t ), intent ( out ), optional :: err if (. not . root_entry ( self , key , payload , err )) return self % keys ( 1 ) = self % keys ( self % n_entries ) self % payloads ( 1 ) = self % payloads ( self % n_entries ) self % insertion ( 1 ) = self % insertion ( self % n_entries ) self % n_entries = self % n_entries - 1 if ( self % n_entries > 1 ) call sift_down ( self , 1_default_int ) end subroutine heap_pop","tags":"","url":"proc/heap_pop.html"},{"title":"heap_push – PIC","text":"private  subroutine heap_push(self, key, payload) Insert one (key, payload) entry in O(log n). Entries pushed earlier pop before equal-key entries pushed later. Type Bound heap_t Arguments Type Intent Optional Attributes Name class( heap_t ), intent(inout) :: self integer(kind=int64), intent(in) :: key integer(kind=int32), intent(in) :: payload Calls proc~~heap_push~~CallsGraph proc~heap_push heap_t%heap_push proc~heap_capacity heap_t%heap_capacity proc~heap_push->proc~heap_capacity proc~heap_reserve heap_t%heap_reserve proc~heap_push->proc~heap_reserve proc~sift_up sift_up proc~heap_push->proc~sift_up proc~heap_reserve->proc~heap_capacity proc~grow_int32 grow_int32 proc~heap_reserve->proc~grow_int32 proc~grow_int64 grow_int64 proc~heap_reserve->proc~grow_int64 proc~precedes precedes proc~sift_up->proc~precedes proc~swap_entries swap_entries proc~sift_up->proc~swap_entries Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent mo