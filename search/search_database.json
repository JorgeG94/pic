urn the value equals `0.<digits> * 10**point_pos`, where !! `<digits>` is `exact(1:n_exact)`. real ( dp ), intent ( in ) :: value character ( len =* ), intent ( out ) :: exact integer ( default_int ), intent ( out ) :: n_exact integer ( default_int ), intent ( out ) :: point_pos integer ( int64 ) :: limb ( MAX_LIMBS ) integer ( int64 ) :: mantissa integer ( default_int ) :: n_limb , n_bits , pow2 , shift n_bits = int ( digits ( value ), default_int ) pow2 = int ( exponent ( value ), default_int ) - n_bits mantissa = int ( scale ( fraction ( value ), n_bits ), int64 ) call bd_set ( limb , n_limb , mantissa ) shift = 0_default_int if ( pow2 > 0_default_int ) then call bd_mul_pow ( limb , n_limb , 2_int64 , pow2 ) else if ( pow2 < 0_default_int ) then call bd_mul_pow ( limb , n_limb , 5_int64 , - pow2 ) shift = - pow2 end if call bd_to_digits ( limb , n_limb , exact , n_exact ) point_pos = n_exact - shift end subroutine expand_exact","tags":"","url":"proc/expand_exact.html"},{"title":"increment_digits – PIC","text":"private pure subroutine increment_digits(rounded, n_rounded, bump) Add one to a decimal digit string, growing it on carry out. Arguments Type Intent Optional Attributes Name character(len=*), intent(inout) :: rounded integer(kind=default_int), intent(inout) :: n_rounded integer(kind=default_int), intent(out) :: bump Called by proc~~increment_digits~~CalledByGraph proc~increment_digits increment_digits proc~round_decimal round_decimal proc~round_decimal->proc~increment_digits proc~to_string_fixed_dp to_string_fixed_dp proc~to_string_fixed_dp->proc~round_decimal proc~to_string_sci_dp to_string_sci_dp proc~to_string_sci_dp->proc~round_decimal interface~to_string_fixed to_string_fixed interface~to_string_fixed->proc~to_string_fixed_dp proc~to_string_fixed_sp to_string_fixed_sp interface~to_string_fixed->proc~to_string_fixed_sp interface~to_string_sci to_string_sci interface~to_string_sci->proc~to_string_sci_dp proc~to_string_sci_sp to_string_sci_sp interface~to