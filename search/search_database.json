colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=default_int), private :: i Source Code pure subroutine vec_dp_resize ( self , n , fill , err ) !! Set the length to `n`, padding with `fill` when growing and dropping !! elements from the end when shrinking. class ( vector_dp_t ), intent ( inout ) :: self integer ( default_int ), intent ( in ) :: n real ( dp ), intent ( in ) :: fill type ( error_t ), intent ( inout ), optional :: err integer ( default_int ) :: i if ( n < 0 ) then call error_raise ( err , ERROR_VALIDATION , \"vector_dp_t: resize() to a negative length.\" ) return end if if ( n <= self % n_items ) then self % n_items = n return end if call vec_dp_grow ( self , n , err ) if ( n > vec_dp_capacity ( self )) return do i = self % n_items + 1 , n self % items ( i ) = fill end do self % n_items = n end subroutine vec_dp_resize","tags":"","url":"proc/vec_dp_resize.html"},{"title":"vec_dp_set – PIC","text":"private pure subroutine vec_dp_set(self, index, value, err) Overwrite element index , 1-based. ERROR_BOUNDS when out of range;\nthis never extends the vector, use push_back or resize for that. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self integer(kind=default_int), intent(in) :: index real(kind=dp), intent(in) :: value type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_set~~CallsGraph proc~vec_dp_set vector_dp_t%vec_dp_set proc~error_raise error_raise proc~vec_dp_set->proc~error_raise proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine vec_dp_set ( self , index , value , err ) !! Overwrite element `index`, 1-based. `ERROR_BOUNDS` when out of range; !! this never extends the vector, use `push_back` or `resize` for that. class ( vector_dp_t ), intent ( inout ) :: self integer ( default_int ), intent ( in ) :: index real ( dp ), intent ( in ) :: value type ( error_t ), intent ( inout ), optional :: err if ( index < 1 . or . index > self % n_items ) then call error_raise ( err , ERROR_BOUNDS , \"vector_dp_t: set() index is out of range.\" ) return end if self % items ( index ) = value end subroutine vec_dp_set","tags":"","url":"proc/vec_dp_set.html"},{"title":"vec_dp_shrink_to_fit – PIC","text":"private pure subroutine vec_dp_shrink_to_fit(self, err) Release capacity beyond size() . Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_shrink_to_fit~~CallsGraph proc~vec_dp_shrink_to_fit vector_dp_t%vec_dp_shrink_to_fit proc~error_raise error_raise proc~vec_dp_shrink_to_fit->proc~error_raise proc~vec_dp_capacity vector_dp_t%vec_dp_capacity proc~vec_dp_shrink_to_fit->proc~vec_dp_capacity proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~vec_dp_shrink_to_fit~~CalledByGraph proc~vec_dp_shrink_to_fit vector_dp_t%vec_dp_shrink_to_fit proc~vec_dp_take vector_dp_t%vec_dp_take proc~vec_dp_take->proc~vec_dp_shrink_to_fit Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=dp), private, allocatable :: exact (:) integer, private :: stat Source Code pure subroutine vec_dp_shrink_to_fit ( self , err ) !! Release capacity beyond `size()`. class ( vector_dp_t ), intent ( inout ) :: self type ( error_t ), intent ( inout ), optional :: err real ( dp ), allocatable :: exact (:) integer :: stat if (. not . allocated ( self % items )) return if ( vec_dp_capacity ( self ) == self % n_items ) return allocate ( exact ( self % n_items ), stat = stat ) if (. not . allocated ( exact )) then call error_raise ( err , ERROR_ALLOC , \"vector_dp_t: shrink_to_fit allocation failed.\" ) return end if if ( self % n_items > 0 ) exact ( 1 : self % n_items ) = self % items ( 1 : self % n_items ) call move_alloc ( exact , self % items ) end subroutine vec_dp_shrink_to_fit","tags":"","url":"proc/vec_dp_shrink_to_fit.html"},{"title":"vec_dp_take – PIC","text":"private pure subroutine vec_dp_take(self, array, err) Hand the storage over to array , exactly sized, without copying the\nelements. The vector is left empty and without storage. This is the load-time idiom: build a vector while parsing an input of\nunknown length, then take the result into the permanent array. as_array copies; this does not. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self real(kind=dp), intent(out), allocatable :: array (:) type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_take~~CallsGraph proc~vec_dp_take vector_dp_t%vec_dp_take proc~vec_dp_capacity vector_dp_t%vec_dp_capacity proc~vec_dp_take->proc~vec_dp_capacity proc~vec_dp_shrink_to_fit vector_dp_t%vec_dp_shrink_to_fit proc~vec_dp_take->proc~vec_dp_shrink_to_fit proc~vec_dp_shrink_to_fit->proc~vec_dp_capacity proc~error_raise error_raise proc~vec_dp_shrink_to_fit->proc~error_raise proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine vec_dp_take ( self , array , err ) !! Hand the storage over to `array`, exactly sized, without copying the !! elements. The vector is left empty and without storage. !! !! This is the load-time idiom: build a vector while parsing an input of !! unknown length, then `take` the result into the permanent array. !! `as_array` copies; this does not. class ( vector_dp_t ), intent ( inout ) :: self real ( dp ), allocatable , intent ( out ) :: array (:) type ( error_t ), intent ( inout ), optional :: err ! Spare capacity would otherwise be handed over as live elements, so the ! shrink is part of the contract rather than an optimisation. call vec_dp_shrink_to_fit ( self , err ) if ( vec_dp_capacity ( self ) /= self % n_items ) return if (. not . allocated ( self % items )) allocate ( self % items ( 0 )) call move_alloc ( self % items , array ) self % n_items = 0 end subroutine vec_dp_take","tags":"","url":"proc/vec_dp_take.html"},{"title":"vec_int32_append – PIC","text":"private pure subroutine vec_int32_append(self, values, err) Append many elements, growing once rather than once per element. Type Bound vector_int32_t Arguments Type Intent Optional Attributes Name class( vector_int32_t ), intent(inout) :: self integer(kind=int32), intent(in) :: values (:) type( error_t ), intent(inout), optional :: err Calls proc~~vec_int32_append~~CallsGraph proc~vec_int32_append vector_int32_t%vec_int32_append proc~error_raise error_raise proc~vec_int32_append->proc~error_raise proc~vec_int32_capacity vector_int32_t%vec_int32_capacity proc~vec_int32_append->proc~vec_int32_capacity proc~vec_int32_grow vec_int32_grow proc~vec_int32_append->proc~vec_int32_grow proc~error_set error_t%error_set proc~error_raise->proc~error_set proc~vec_int32_grow->proc~error_raise proc~vec_int32_grow->proc~vec_int32_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=default_int), private :: n_new Source Code pure subroutine vec_int32_append ( self , values , err ) !! Append many elements, growing once rather than once per element. class ( vector_int32_t ), intent ( inout ) :: self integer ( int32 ), intent ( in ) :: values (:) type ( error_t ), intent ( inout ), optional :: err integer ( default_int ) :: n_new n_new = size ( values , kind = default_int ) if ( n_new == 0 ) return ! Rearranged from `n_items + n_new > MAX` so that the sum is never ! formed; the subtraction cannot overflow because `n_items` is ! non-negative and PIC_VECTOR_MAX_CAPACITY is `huge`. if ( n_new > PIC_VECTOR_MAX_CAPACITY - self % n_items ) then call error_raise ( err , ERROR_ALLOC , & \"vector_int32_t: append would exceed PIC_VECTOR_MAX_CAPACITY.\" ) return end if call vec_int32_grow ( self , self % n_items + n_new , err ) if ( self % n_items + n_new > vec_int32_capacity ( self )) return self % items ( self % n_items + 1 : self % n_items + n_new ) = values self % n_items = self % n_items + n_new end subroutine vec_int32_append","tags":"","url":"proc/vec_int32_append.html"},{"title":"vec_int32_at – PIC","text":"private pure subroutine vec_int32_at(self, index, value, err) Read element index , 1-based. ERROR_BOUNDS when out of range. Type Bound vector_int32_t Arguments Type Intent Optional Attributes Name class( vector_int32_t ), intent(in) :: self integer(kind=default_int), intent(in) :: index integer(kind=int32), intent(out) :: value type( error_t ), intent(inout), optional :: err Calls proc~~vec_int32_at~~CallsGraph proc~vec_int32_at vector_int32_t%vec_int32_at p