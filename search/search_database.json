= 0_int64 turns = 0_default_int do word = gen % next_u64 () cell = int ( ibits ( word , 0_default_int , EXP_CELL_BITS ), default_int ) if ( cell < EXP_TOP_CELL . or . turns >= EXP_MAX_TAIL ) then if ( cell >= EXP_TOP_CELL ) cell = EXP_TOP_CELL - 1_default_int frac = int ( ibits ( word , 33_default_int , FRAC_BITS ), default_int ) gap = EXP_TABLE ( cell + 1_default_int ) - EXP_TABLE ( cell ) x_q32 = x_q32 + EXP_TABLE ( cell ) + u64_shr ( gap * int ( frac , int64 ), FRAC_BITS ) exit end if x_q32 = x_q32 + EXP_LN_CELLS turns = turns + 1_default_int end do r = scale_by_mean ( x_q32 , mean ) end function splitmix64_next_exponential_int","tags":"","url":"proc/splitmix64_next_exponential_int.html"},{"title":"splitmix64_next_poisson_int – PIC","text":"private  function splitmix64_next_poisson_int(gen, mean_milli, err) result(r) Poisson count with mean mean_milli/1000 , from a splitmix64_t generator. Arguments Type Intent Optional Attributes Name type( splitmix64_t ), intent(inout) :: gen Generator, advanced once per inter-arrival drawn. integer(kind=default_int), intent(in) :: mean_milli A thousand times the mean, in [0, POISSON_MAX_MEAN_MILLI] . type( error_t ), intent(inout), optional :: err Set to ERROR_VALIDATION when mean_milli is out of range. Return Value integer(kind=int32) Calls proc~~splitmix64_next_poisson_int~~CallsGraph proc~splitmix64_next_poisson_int splitmix64_next_poisson_int proc~error_set error_t%error_set proc~splitmix64_next_poisson_int->proc~error_set proc~splitmix64_next_exponential_int splitmix64_next_exponential_int proc~splitmix64_next_poisson_int->proc~splitmix64_next_exponential_int proc~splitmix64_next_exponential_int->proc~error_set proc~scale_by_mean scale_by_mean proc~splitmix64_next_exponential_int->proc~scale_by_mean proc~splitmix64_next_u64 splitmix64_t%splitmix64_next_u64 proc~splitmix64_next_exponential_int->proc~splitmix64_next_u64 proc~u64_shr u64_shr proc~splitmix64_next_exponential_int->proc~u64_shr proc~scale_by_mean->proc~u64_shr p