\nout of the hot path. Type Bound fixed_array_dp_t Arguments Type Intent Optional Attributes Name class( fixed_array_dp_t ), intent(in) :: self Return Value real(kind=dp), allocatable, (:) Source Code pure function fixed_array_dp_as_array ( self ) result ( arr ) !! Copy of the live elements as a plain array of extent `size()`, !! not `capacity()`. Returns a zero-length array when empty. This is !! how the contents are handed to ordinary Fortran routines; note !! that it is the one operation here that does allocate, so keep it !! out of the hot path. class ( fixed_array_dp_t ), intent ( in ) :: self real ( dp ), allocatable :: arr (:) allocate ( arr ( self % n_items )) arr ( 1 : self % n_items ) = self % items ( 1 : self % n_items ) end function fixed_array_dp_as_array","tags":"","url":"proc/fixed_array_dp_as_array.html"},{"title":"fixed_array_dp_capacity – PIC","text":"private pure function fixed_array_dp_capacity(self) result(n) Maximum number of elements, i.e. PIC_FIXED_ARRAY_CAPACITY . Type Bound fixed_array_dp_t Arguments Type Intent Optional Attributes Name class( fixed_array_dp_t ), intent(in) :: self Return Value integer(kind=default_int) Source Code pure function fixed_array_dp_capacity ( self ) result ( n ) !! Maximum number of elements, i.e. `PIC_FIXED_ARRAY_CAPACITY`. class ( fixed_array_dp_t ), intent ( in ) :: self integer ( default_int ) :: n n = int ( size ( self % items ), default_int ) end function fixed_array_dp_capacity","tags":"","url":"proc/fixed_array_dp_capacity.html"},{"title":"fixed_array_dp_get_unchecked – PIC","text":"private pure function fixed_array_dp_get_unchecked(self, index) result(value) UNCHECKED element access for inner loops: no bounds check at all.\nThe caller is responsible for guaranteeing 1 <= index <= size() ,\ntypically by looping over 1, array%size() . Reading an index\noutside that range returns undefined data. Use at unless the\nbounds check is measurably in the way. Type Bound fixed_array_dp_t Arguments Type Intent Optional Attributes Name class( fixed_array_dp_t ), intent(in) :: self integer(kind=default_int), intent(in) :: index Return Value real(kind=dp) Source Code pure function fixed_array_dp_get_unchecked ( self , index ) result ( value ) !! UNCHECKED element access for inner loops: no bounds check at all. !! The caller is responsible for guaranteeing `1 <= index <= size()`, !! typically by looping over `1, array%size()`. Reading an index !! outside that range returns undefined data. Use `at` unless the !! bounds check is measurably in the way. class ( fixed_array_dp_t ), intent ( in ) :: self integer ( default_int ), intent ( in ) :: index real ( dp ) :: value value = self % items ( index ) end function fixed_array_dp_get_unchecked","tags":"","url":"proc/fixed_array_dp_get_unchecked.html"},{"title":"fixed_array_dp_is_empty – PIC","text":"private pure function fixed_array_dp_is_empty(self) result(empty) True when no elements are live. Type Bound fixed_array_dp_t Arguments Type Intent Optional Attributes Name class( fixed_array_dp_t ), intent(in) :: self Return Value logical Source Code pure function fixed_array_dp_is_empty ( self ) result ( empty ) !! True when no elements are live. class ( fixed_array_dp_t ), intent ( in ) :: self logical :: empty empty = ( self % n_items <= 0_default_int ) end function fixed_array_dp_is_empty","tags":"","url":"proc/fixed_array_dp_is_empty.html"},{"title":"fixed_array_dp_is_full – PIC","text":"private pure function fixed_array_dp_is_full(self) result(full) True when a further push_back would fail. Type Bound fixed_array_dp_t Arguments Type Intent Optional Attributes Name class( fixed_array_dp_t ), intent(in) :: self Return Value logical Source Code pure function fixed_array_dp_is_full ( self ) result ( full ) !! True when a further `push_back` would fail. class ( fixed_array_dp_t ), intent ( in ) :: self logical :: full full = ( self % n_items >= PIC_FIXED_ARRAY_CAPACITY ) end function fixed_array_dp_is_full","tags":"","url":"proc/fixed_array_dp_is_full.html"},{"title":"fixed_array_dp_size – PIC","text":"private pure function fixed_array_dp_size(self) result(n) Number of live elements. Type Bound fixed_array_dp_t Arguments Type Intent Optional Attributes Name class( fixed_array_dp_t ), intent(in) :: self Return Value integer(kind=default_int) Source Code pure function fixed_array_dp_size ( self ) result ( n ) !! Number of live elements. class ( fixed_array_dp_t ), intent ( in ) :: self integer ( default_int ) :: n n = self % n_items end function fixed_array_dp_size","tags":"","url":"proc/fixed_array_dp_size.html"},{"title":"fixed_array_int_as_array – PIC","text":"private pure function fixed_array_int_as_array(self) result(arr) Copy of the live elements as a plain array of extent size() ,\nnot capacity() . Returns a zero-length array when empty. This is\nhow the contents are handed to ordinary Fortran routines; note\nthat it is the one operation here that does allocate, so keep it\nout of the hot path. Type Bound fixed_array_int_t Arguments Type Intent Optional Attributes Name class( fixed_array_int_t ), intent(in) :: self Return Value integer(kind=default_int), allocatable, (:) Source Code pure function fixed_array_int_as_array ( self ) result ( arr ) !! Copy of the live elements as a plain array of extent `size()`, !! not `capacity()`. Returns a zero-length array when empty. This is !! how the contents are handed to ordinary Fortran routines; note !! that it is the one operation here that does allocate, so keep it !! out of the hot path. class ( fixed_array_int_t ), intent ( in ) :: self integer ( default_int ), allocatable :: arr (:) allocate ( arr ( self % n_items )) arr ( 1 : self % n_items ) = self % items ( 1 : self % n_items ) end function fixed_array_int_as_array","tags":"","url":"proc/fixed_array_int_as_array.html"},{"title":"fixed_array_int_capacity – PIC","text":"private pure function fixed_array_int_capacity(self) result(n) Maximum number of elements, i.e. PIC_FIXED_ARRAY_CAPACITY . Type Bound fixed_array_int_t Arguments Type Intent Optional Attributes Name class( fixed_array_int_t ), intent(in) :: self Return Value integer(kind=default_int) Source Code pure function fixed_array_int_capacity ( self ) result ( n ) !! Maximum number of elements, i.e. `PIC_FIXED_ARRAY_CAPACITY`. class ( fixed_array_int_t ), intent ( in ) :: self integer ( default_int ) :: n n = int ( size ( self % items ), default_int ) end function fixed_array_int_capacity","tags":"","url":"proc/fixed_array_int_capacity.html"},{"title":"fixed_array_int_get_unchecked – PIC","text":"private pure function fixed_array_int_get_unchecked(self, index) result(value) UNCHECKED element access for inner loops: no bounds check at all.\nThe caller is responsible for guaranteeing 1 <= index <= size() ,\ntypically by looping over 1, array%size() . Reading an index\noutside that range returns undefined data. Use at unless the\nbounds check is measurably in the way. Type Bound fixed_array_int_t Arguments Type Intent Optional Attributes Name class( fixed_array_int_t ), intent(in) :: self integer(kind=default_int), intent(in) :: index Return Value integer(kind=default_int) Source Code pure function fixed_array_int_get_unchecked ( self , index ) result ( value ) !! UNCHECKED element access for inner loops: no bounds check at all. !! The caller is responsible for guaranteeing `1 <= index <= size()`, !! typically by looping over `1, array%size()`. Reading an index !! outside that range returns undefined data. Use `at` unless the !! bounds check is measurably in the way. class ( fixed_array_int_t ), intent ( in ) :: self integer ( default_int ), intent ( in ) :: index integer ( default_int ) :: value value = self % items ( index ) end function fixed_array_int_get_unchecked","tags":"","url":"proc/fixed_array_int_get_unchecked.html"},{"title":"fixed_array_int_is_empty – PIC","text":"private pure function fixed_array_int_is_empty(self) result(empty) True when no elements are live. Type Bound fixed_array_int_t A