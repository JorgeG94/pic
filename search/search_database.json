inout ), optional :: err integer ( default_int ) :: i if ( n < 0 ) then call error_raise ( err , ERROR_VALIDATION , \"vector_int32_t: resize() to a negative length.\" ) return end if if ( n <= self % n_items ) then self % n_items = n return end if call vec_int32_grow ( self , n , err ) if ( n > vec_int32_capacity ( self )) return do i = self % n_items + 1 , n self % items ( i ) = fill end do self % n_items = n end subroutine vec_int32_resize","tags":"","url":"proc/vec_int32_resize.html"},{"title":"vec_int32_set – PIC","text":"private pure subroutine vec_int32_set(self, index, value, err) Overwrite element index , 1-based. ERROR_BOUNDS when out of range;\nthis never extends the vector, use push_back or resize for that. Type Bound vector_int32_t Arguments Type Intent Optional Attributes Name class( vector_int32_t ), intent(inout) :: self integer(kind=default_int), intent(in) :: index integer(kind=int32), intent(in) :: value type( error_t ), intent(inout), optional :: err Calls proc~~vec_int32_set~~CallsGraph proc~vec_int32_set vector_int32_t%vec_int32_set proc~error_raise error_raise proc~vec_int32_set->proc~error_raise proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine vec_int32_set ( self , index , value , err ) !! Overwrite element `index`, 1-based. `ERROR_BOUNDS` when out of range; !! this never extends the vector, use `push_back` or `resize` for that. class ( vector_int32_t ), intent ( inout ) :: self integer ( default_int ), intent ( in ) :: index integer ( int32 ), intent ( in ) :: value type ( error_t ), intent ( inout ), optional :: err if ( index < 1 . or . index > self % n_items ) then call error_raise ( err , ERROR_BOUNDS , \"vector_int32_t: set() index is out of range.\" ) return end if self % items ( index ) = value end subroutine vec_int32_set","tags":"","url":"proc/vec_int32_set.html"},{"title":"vec_int32_shrink_to_fit – PIC","text":"private pure subroutine vec_int32_shrink_to_fit(self, err) Release capacity beyond size() . Type Bound vector_int32_t Arguments Type Intent Optional Attributes Name class( vector_int32_t ), intent(inout) :: self type( error_t ), intent(inout), optional :: err Calls proc~~vec_int32_shrink_to_fit~~CallsGraph proc~vec_int32_shrink_to_fit vector_int32_t%vec_int32_shrink_to_fit proc~error_raise error_raise proc~vec_int32_shrink_to_fit->proc~error_raise proc~vec_int32_capacity vector_int32_t%vec_int32_capacity proc~vec_int32_shrink_to_fit->proc~vec_int32_capacity proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~vec_int32_shrink_to_fit~~CalledByGraph proc~vec_int32_shrink_to