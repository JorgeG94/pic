gative and PIC_VECTOR_MAX_CAPACITY is `huge`. if ( n_new > PIC_VECTOR_MAX_CAPACITY - self % n_items ) then call error_raise ( err , ERROR_ALLOC , & \"vector_dp_t: append would exceed PIC_VECTOR_MAX_CAPACITY.\" ) return end if call vec_dp_grow ( self , self % n_items + n_new , err ) if ( self % n_items + n_new > vec_dp_capacity ( self )) return self % items ( self % n_items + 1 : self % n_items + n_new ) = values self % n_items = self % n_items + n_new end subroutine vec_dp_append","tags":"","url":"proc/vec_dp_append.html"},{"title":"vec_dp_at – PIC","text":"private pure subroutine vec_dp_at(self, index, value, err) Read element index , 1-based. ERROR_BOUNDS when out of range. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(in) :: self integer(kind=default_int), intent(in) :: index real(kind=dp), intent(out) :: value type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_at~~CallsGraph proc~vec_dp_at vector_dp_t%vec_dp_at proc~error_raise error_raise proc~vec_dp_at->proc~error_raise proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine vec_dp_at ( self , index , value , err ) !! Read element `index`, 1-based. `ERROR_BOUNDS` when out of range. class ( vector_dp_t ), intent ( in ) :: self integer ( default_int ), intent ( in ) :: index real ( dp ), intent ( out ) :: value type ( error_t ), intent ( inout ), optional :: err if ( index < 1 . or . index > self % n_items ) then call error_raise ( err , ERROR_BOUNDS , \"vector_dp_t: at() index is out of range.\" ) return end if value = self % items ( index ) end subroutine vec_dp_at","tags":"","url":"proc/vec_dp_at.html"},{"title":"vec_dp_clear – PIC","text":"private pure subroutine vec_dp_clear(self) Drop every element but keep the allocated storage, so a vector reused\nacross iterations of an outer loop stops reallocating. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self Source Code pure subroutine vec_dp_clear ( self ) !! Drop every element but keep the allocated storage, so a vector reused !! across iterations of an outer loop stops reallocating. class ( vector_dp_t ), intent ( inout ) :: self self % n_items = 0 end subroutine vec_dp_clear","tags":"","url":"proc/vec_dp_clear.html"},{"title":"vec_dp_destroy – PIC","text":"private pure subroutine vec_dp_destroy(self) Release all storage and reset to the empty state. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self Source Code pure subroutine vec_dp_destroy ( self ) !! Release all storage and reset to the empty state. class ( vector_dp_t ), intent ( inout ) :: self self % n_items = 0 if ( allocated ( self % items )) deallocate ( self % items ) end subroutine vec_dp_destroy","tags":"","url":"proc/vec_dp_destroy.html"},{"title":"vec_dp_grow – PIC","text":"private pure subroutine vec_dp_grow(self, needed, err) Ensure capacity for at least needed elements, preserving the live\nones. Capacity starts at PIC_VECTOR_MIN_CAPACITY and doubles, which\nkeeps a run of push_back calls amortised O(1). Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self integer(kind=default_int), intent(in) :: needed type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_grow~~CallsGraph proc~vec_dp_grow vec_dp_grow proc~error_raise error_raise proc~vec_dp_grow->proc~error_raise proc~vec_dp_capacity vector_dp_t%vec_dp_capacity proc~vec_dp_grow->proc~vec_dp_capacity proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~vec_dp_grow~~CalledByGraph proc~vec_dp_grow vec_dp_grow proc~vec_dp_append vector_dp_t%vec_dp_append proc~vec_dp_append->proc~vec_dp_grow proc~vec_dp_push_back vector_dp_t%vec_dp_push_back proc~vec_dp_push_back->proc~vec_dp_grow proc~vec_dp_reserve vector_dp_t%vec_dp_reserve proc~vec_dp_reserve->proc~vec_dp_grow proc~vec_dp_resize vector_dp_t%vec_dp_resize proc~vec_dp_resize->proc~vec_dp_grow Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=dp), private, allocatable :: bigger (:) integer(kind=default_int), private :: new_capacity integer, private :: stat Source Code pure subroutine vec_dp_grow ( self , needed , err ) !! Ensure capacity for at least `needed` elements, preserving the live !! ones. Capacity starts at PIC_VECTOR_MIN_CAPACITY and doubles, which !! keeps a run of `push_back` calls amortised O(1). class ( vector_dp_t ), intent ( inout ) :: self integer ( default_int ), intent ( in ) :: needed type ( error_t ), intent ( inout ), optional :: err real ( dp ), allocatable :: bigger (:) integer ( default_int ) :: new_capacity integer :: stat if ( needed <= vec_dp_capacity ( self )) return ! `needed` is negative only if a caller's arithmetic wrapped on the way ! in. It cannot be compared against PIC_VECTOR_MAX_CAPACITY, which is ! `huge(0_default_int)` and so can never be exceeded by a value of that ! kind -- a guard written that way is dead code. The callers below check ! their headroom before adding; this catches anything that slips past. if ( needed < 0_default_int ) then call error_raise ( err , ERROR_ALLOC , & \"vector_dp_t: requested capacity overflowed.\" ) return end if new_capacity = max ( vec_dp_capacity ( self ), PIC_VECTOR_MIN_CAPACITY ) do while ( new_capacity < needed ) ! Doubling is done only when it cannot overflow default_int; past that ! point the clamp is the only remaining step, and `needed` is already ! known to fit. if ( new_capacity > PIC_VECTOR_MAX_CAPACITY / 2 ) then new_capacity = PIC_VECTOR_MAX_CAPACITY exit end if new_capacity = 2 * new_capacity end do allocate ( bigger ( new_capacity ), stat = stat ) ! `allocated` rather than `stat`: nvfortran does not set stat reliably ! for every element type, while `allocated` always reports the truth. if (. not . allocated ( bigger )) then call error_raise ( err , ERROR_ALLOC , \"vector_dp_t: allocation of backing storage failed.\" ) return end if if ( self % n_items > 0 ) bigger ( 1 : self % n_items ) = self % items ( 1 : self % n_items ) call move_alloc ( bigger , self % items ) end subroutine vec_dp_grow","tags":"","url":"proc/vec_dp_grow.html"},{"title":"vec_dp_pop_back – PIC","text":"private pure subroutine vec_dp_pop_back(self, value, err) Remove and return the last element. ERROR_BOUNDS when empty, in\nwhich case the vector is unchanged. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self real(kind=dp), intent(out) :: value type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_pop_back~~CallsGraph proc~vec_dp_pop_back vector_dp_t%vec_dp_pop_back proc~error_raise error_raise proc~vec_dp_pop_back->proc~error_raise proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine vec_dp_pop_back ( self , value , err ) !! Remove and return the last element. `ERROR_BOUNDS` when empty, in !! which case the vector is unchanged. class ( vector_dp_t ), intent ( inout ) :: self real ( dp ), intent ( out ) :: value type ( error_t ), intent ( inout ), optional :: err if ( self % n_items <= 0 ) then call error_raise ( err , ERROR_BOUNDS , \"vector_dp_t: pop_back on an empty vector.\" ) return end if value = self % items ( self % n_items ) self % n_items = self % n_items - 1 end subroutine vec_dp_pop_back","tags":"","url":"proc/vec_dp_pop_back.html"},{"title":"vec_dp_push_back – PIC","text":"private pure subroutine vec_dp_push_back(self, value, err) Append one element. ERROR_ALLOC if storage cannot be grown, in which\ncase the vector is unchanged. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self real(kind=dp), intent(in) :: value type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_push_back~~CallsGraph proc~vec_dp_push_back vector_dp_t%vec_dp_push_back proc~error_raise error_raise proc~vec_dp_push_back->proc~error_raise proc~vec_dp_capacity vector_dp_t%vec_dp_capacity proc~vec_dp_push_back->proc~vec_dp_capacity proc~vec_dp_grow vec_dp_grow proc~vec_dp_push_back->proc~vec_dp_grow proc~error_set error_t%error_set proc~error_raise->proc~error_set proc~vec_dp_grow->proc~error_raise proc~vec_dp_grow->proc~vec_dp_capacity Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure subroutine vec_dp_push_back ( self , value , err ) !! Append one element. `ERROR_ALLOC` if storage cannot be grown, in which !! case the vector is unchanged. class ( vector_dp_t ), intent ( inout ) :: self real ( dp ), intent ( in ) :: value type ( error_t ), intent ( inout ), optional :: err ! Checked before adding, not after: `n_items + 1` at the maximum wraps ! negative, and every downstream test would then read as \"plenty of ! room\" while the append walked off the end of the array. if ( self % n_items >= PIC_VECTOR_MAX_CAPACITY ) then call error_raise ( err , ERROR_ALLOC , & \"vector_dp_t: already holds PIC_VECTOR_MAX_CAPACITY elements.\" ) return end if call vec_dp_grow ( self , self % n_items + 1 , err ) if ( self % n_items + 1 > vec_dp_capacity ( self )) return self % n_items = self % n_items + 1 self % items ( self % n_items ) = value end subroutine vec_dp_push_back","tags":"","url":"proc/vec_dp_push_back.html"},{"title":"vec_dp_reserve – PIC","text":"private pure subroutine vec_dp_reserve(self, n, err) Make room for at least n elements. size() is unchanged. Type Bound vector_dp_t Arguments Type Intent Optional Attributes Name class( vector_dp_t ), intent(inout) :: self integer(kind=default_int), intent(in) :: n type( error_t ), intent(inout), optional :: err Calls proc~~vec_dp_reserve~~CallsGraph proc~vec_dp_reserve vector_dp_t%vec_dp_reserve proc~vec_dp_grow vec_dp_grow proc~vec_dp_reserve->proc~vec_dp_grow proc~error_raise error_raise proc~vec_dp_grow->proc~error_raise proc~vec_dp_capacity vector_dp_t%vec_dp_capacity proc~vec_dp_grow->proc~vec_dp_capacity proc~error_set error_t%error_set proc~error_raise->proc~error_set Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connectin