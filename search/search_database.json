e_csp_0 , & update_csp_1 , & update_csp_2 , & update_csp_3 , & update_cdp_0 , & update_cdp_1 , & update_cdp_2 , & update_cdp_3 , & update_logical_0 , & update_logical_1 , & update_logical_2 , & update_logical_3 , & update_char_0 , & update_char_1 procedure , private :: update_int8_0 procedure , private :: update_int8_1 procedure , private :: update_int8_2 procedure , private :: update_int8_3 procedure , private :: update_int16_0 procedure , private :: update_int16_1 procedure , private :: update_int16_2 procedure , private :: update_int16_3 procedure , private :: update_int32_0 procedure , private :: update_int32_1 procedure , private :: update_int32_2 procedure , private :: update_int32_3 procedure , private :: update_int64_0 procedure , private :: update_int64_1 procedure , private :: update_int64_2 procedure , private :: update_int64_3 procedure , private :: update_rsp_0 procedure , private :: update_rsp_1 procedure , private :: update_rsp_2 procedure , private :: update_rsp_3 procedure , private :: update_rdp_0 procedure , private :: update_rdp_1 procedure , private :: update_rdp_2 procedure , private :: update_rdp_3 procedure , private :: update_csp_0 procedure , private :: update_csp_1 procedure , private :: update_csp_2 procedure , private :: update_csp_3 procedure , private :: update_cdp_0 procedure , private :: update_cdp_1 procedure , private :: update_cdp_2 procedure , private :: update_cdp_3 procedure , private :: update_logical_0 procedure , private :: update_logical_1 procedure , private :: update_logical_2 procedure , private :: update_logical_3 procedure , private :: update_char_0 procedure , private :: update_char_1 end type array_hash_t","tags":"","url":"type/array_hash_t.html"},{"title":"hash_map_t – PIC ","text":"type, public :: hash_map_t Insertion-ordered hash map: character(len=*) keys, integer(int64) values. Default initialisation yields a valid empty map; the first insert allocates with default capacity if init was never called. Components Type Visibility Attributes Name Initial integer(kind=default_int), private, allocatable :: buckets (:) Bucket table; BUCKET_EMPTY or an index into the entry table. integer(kind=default_int), private :: entry_cap = 0 Allocated length of the entry arrays. integer(kind=int64), private, allocatable :: entry_value (:) Value of each entry, in insertion order. character(len=1), private, allocatable :: key_pool (:) Packed storage for all key characters. integer(kind=default_int), private, allocatable :: key_size (:) Length in characters of each key, in insertion order. integer(kind=default_int), private, allocatable :: key_start (:) First character of each key inside key_pool , in insertion order. integer(kind=default_int), private :: n_buckets = 0 Number of buckets, always a power of two, 0 while unallocated. integer(kind=default_int), private :: n_entries = 0 Number of live entries, i.e. the value returned by size() . integer(kind=default_int), private :: pool_cap = 0 Allocated length of key_pool . integer(kind=default_int), private :: pool_used = 0 Number of characters currently used in key_pool . Type-Bound Procedures procedure, public :: at => hash_map_at private  subroutine hash_map_at (this, position, key, value, err) Fetch the entry at position in the iteration order, counting from 1.\nThis is the exact-fidelity iteration accessor: key comes back with\nthe key’s true length, trailing blanks included. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this integer(kind=default_int), intent(in) :: position character(len=:), intent(out), allocatable :: key integer(kind=int64), intent(out) :: value type( error_t ), intent(out), optional :: err procedure, public :: bucket_count => hash_map_bucket_count private pure function hash_map_bucket_count (this) result(n) Current number of buckets, 0 while the map is unallocated. Exposed so\nthat callers and tests can observe growth; it never affects iteration\norder. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value integer(kind=default_int) procedure, public :: clear => hash_map_clear private  subroutine hash_map_clear (this) Remove every entry but keep the allocated capacity, so that refilling\nthe map does not have to reallocate. A cleared map iterates as empty\nand the next insert starts a fresh insertion order at position 1. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this procedure, public :: destroy => hash_map_destroy private  subroutine hash_map_destroy (this) Release every buffer and return the map to the unallocated state. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this procedure, public :: get => hash_map_get private  subroutine hash_map_get (this, key, value, found) Look up key . A missing key is an ordinary outcome, not an error: found comes back .false. and value is set to 0. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this character(len=*), intent(in) :: key integer(kind=int64), intent(out) :: value logical, intent(out) :: found procedure, public :: has_key => hash_map_has_key private  function hash_map_has_key (this, key) result(present_in_map) .true. when key is stored in the map. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this character(len=*), intent(in) :: key Return Value logical procedure, public :: init => hash_map_init private  subroutine hash_map_init (this, initial_capacity) Allocate the map, discarding any entries it already held. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this integer(kind=default_int), intent(in), optional :: initial_capacity procedure, public :: insert => hash_map_insert private  subroutine hash_map_insert (this, key, value) Insert key with value , or overwrite the value of an existing key. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this character(len=*), intent(in) :: key Stored verbatim; trailing blanks are part of the key. integer(kind=int64), intent(in) :: value procedure, public :: is_empty => hash_map_is_empty private pure function hash_map_is_empty (this) result(empty) .true. when the map holds no entries. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value logical procedure, public :: keys => hash_map_keys private  function hash_map_keys (this) result(res) All keys, in insertion order. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value character(len=:), allocatable, (:) procedure, public :: remove => hash_map_remove private  subroutine hash_map_remove (this, key, err) Remove key from the map. Read more… Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(inout) :: this character(len=*), intent(in) :: key type( error_t ), intent(out), optional :: err procedure, public :: size => hash_map_size private pure function hash_map_size (this) result(n) Number of entries currently stored. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value integer(kind=default_int) procedure, public :: values => hash_map_values private  function hash_map_values (this) result(res) All values, in insertion order. values() and keys() are index\naligned: values(i) belongs to keys(i) . Zero-sized for an empty\nmap. Arguments Type Intent Optional Attributes Name class( hash_map_t ), intent(in) :: this Return Value integer(kind=int64), allocatable, (:) Source Code type :: hash_map_t !! Insertion-ordered hash map: `character(len=*)` keys, `integer(int64)` !! values. Default initialisation yields a valid empty map; the first !! `insert` allocates with default capacity if `init` was never called. private integer ( default_int ) :: n_buckets = 0 !! Number of buckets, always a power of two, 0 while unallocated. integer ( default_int ), allocatable :: buckets (:) !! Bucket table; `BUCKET_EMPTY` or an index into the entry table. integer ( default_int ) :: n_entries = 0 !! Number of live entries, i.e. the value returned by `size()`. integer ( default_int ) :: entry_cap = 0 !! Allocated length of the entry arrays. integer ( default_int ), allocatable :: key_start (:) !! First character of each key inside `key_pool`, in insertion order. integer ( default_int ), allocatable :: key_size (:) !! Length in characters of each key, in insertion order. integer ( int64 ), allocatable :: entry_value (:) !! Value of each entry, in insertion order. character ( len = 1 ), allocatable :: key_pool (:) !! Packed storage for all key characters. integer ( default_int ) :: pool_used = 0 !! Number of characters currently used in `key_pool`. integer ( default_int ) :: pool_cap = 0 !! Allocated length of `key_pool`. contains procedure :: init => hash_map_init procedure :: destroy => hash_map_destroy procedure :: clear => hash_map_clear procedure :: size => hash_map_size procedure :: is_empty => hash_map_is_empty procedure :: bucket_count => hash_map_bucket_count procedure :: insert => hash_map_insert procedure :: get => hash_map_get procedure :: has_key => hash_map_has_key procedure :: remove => hash_map_remove procedure :: keys => hash_map_keys procedure :: values => hash_map_values procedure :: at => hash_map_at end type hash_map_t","tags":"","url":"type/hash_map_t.html"},{"title":"particle_soa_t – PIC ","text":"type, public :: particle_soa_t 6 parallel field arrays plus size/capacity bookkeeping. Inherits type~~particle_soa_t~~InheritsGraph type~particle_soa_t particle_soa_t type~soa_extent_t soa_extent_t type~particle_soa_t->type~soa_extent_t extent Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial logical, public, allocatable :: active (:) Whether the particle takes part in the simulation. type( soa_extent_t ), public :: extent Live element count and allocated capacity. integer(kind=int32), public, allocatable :: id (:) Particle identifier. real(kind=dp), public, allocatable :: mass (:) Particle mass. real(kind=dp), public, allocatable :: x (:) Cartesian x coordinate. real(kind=dp), public, allocatable :: y (:) Cartesian y coordinate. real(kind=dp), public, allocatable :: z (:) Cartesian z coordinate. Type-Bound Procedures procedure, public :: allocate => particle_soa_allocate private  subroutine particle_soa_allocate (this, n, err) Give the container n live elements, discarding any it already had. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to (re)allocate. integer(kind=default_int), intent(in) :: n Number of live elements. Must not be negative. type( error_t ), intent(inout) :: err Error state, ERROR_VALIDATION on a negative n and ERROR_ALLOC if the field arrays cannot be allocated. procedure, public :: capacity => particle_soa_capacity private pure function particle_soa_capacity (this) result(n) Allocated length of every field array. Always at least size() . Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to query. Return Value integer(kind=default_int) procedure, public :: clear => particle_soa_clear private  subroutine particle_soa_clear (this) Drop every live element but keep the allocated capacity. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to empty. procedure, public :: deallocate => particle_soa_deallocate private  subroutine particle_soa_deallocate (this) Release every field array and reset both counters to zero. Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to empty. procedure, public :: deserialize => particle_soa_deserialize private  subroutine particle_soa_deserialize (this, unit, err) Read a container back from an open stream unit. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to fill. Any previous contents are discarded. integer(kind=default_int), intent(in) :: unit Stream unit opened for unformatted stream reading. type( error_t ), intent(inout) :: err Error state, ERROR_VALIDATION on a layout or length mismatch and ERROR_IO on a truncated stream. procedure, public :: resize => particle_soa_resize private  subroutine particle_soa_resize (this, n, err) Change the number of live elements, preserving the elements that\nsurvive. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(inout) :: this Container to resize. integer(kind=default_int), intent(in) :: n New number of live elements. Must not be negative. type( error_t ), intent(inout) :: err Error state, ERROR_VALIDATION on a negative n and ERROR_ALLOC if a field array cannot be allocated. procedure, public :: serialize => particle_soa_serialize private  subroutine particle_soa_serialize (this, unit, err) Write the container to an open stream unit. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to write. integer(kind=default_int), intent(in) :: unit Stream unit opened for unformatted stream writing. type( error_t ), intent(inout) :: err Error state, ERROR_IO if the stream cannot be written. procedure, public :: serialized_bytes => particle_soa_serialized_bytes private pure function particle_soa_serialized_bytes (this) result(nbytes) Exact size in bytes of the stream serialize would write now. Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to measure. Return Value integer(kind=int64) procedure, public :: size => particle_soa_size private pure function particle_soa_size (this) result(n) Number of live elements. Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to query. Return Value integer(kind=default_int) procedure, public :: state_hash => particle_soa_state_hash private  function particle_soa_state_hash (this) result(digest) 32-bit FNV-1a digest of the container’s live state. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to fingerprint. Return Value integer(kind=int32) procedure, public :: state_hash64 => particle_soa_state_hash64 private  function particle_soa_state_hash64 (this) result(digest) 64-bit FNV-1a digest of the container’s live state. Read more… Arguments Type Intent Optional Attributes Name class( particle_soa_t ), intent(in) :: this Container to fingerprint. Return Value integer(kind=int64) Source Code type :: particle_soa_t !! 6 parallel field arrays plus size/capacity bookkeeping. type ( soa_extent_t ) :: extent !! Live element count and allocated capacity. integer ( int32 ), allocatable :: id (:) !! Particle identifier. real ( dp ), allocatable :: x (:) !! Cartesian x coordinate. real ( dp ), allocatable :: y (:) !! Cartesian y coordinate. real ( dp ), allocatable :: z (:) !! Cartesian z coordinate. real ( dp ), allocatable :: mass (:) !! Particle mass. logical , allocatable :: active (:) !! Whether the particle takes part in the simulation. contains procedure :: allocate => particle_soa_allocate procedure :: resize => particle_soa_resize procedure :: deallocate => particle_soa_deallocate procedure :: clear => particle_soa_clear procedure :: size => particle_soa_size procedure :: capacity => particle_soa_capacity procedure :: serialized_bytes => particle_soa_serialized_bytes procedure :: serialize => particle_soa_serialize procedure :: deserialize => particle_soa_deserialize procedure :: state_hash => particle_soa_state_hash procedure :: state_hash64 => particle_soa_state_hash64 end type particle_soa_t","tags":"","url":"type/particle_soa_t.html"},{"title":"frame_t – PIC ","text":"type, public :: frame_t A screen’s worth of text lines, rendered by diffing against the last. The model is “set every line, render, repeat”. render compares each\nline with what was last rendered and emits moves and rewrites only\nfor the rows that changed, so an otherwise idle board that updates a\nclock writes one line rather than twenty-four. That is what makes the\nsimple model flicker-free. Inherits type~~frame_t~~InheritsGraph type~frame_t frame_t type~string_type string_type type~frame_t->type~string_type current, shown Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial integer(kind=default_int), private :: cols = 0_default_int Width in code points; set_line truncates to it. type( string_type ), private, allocatable :: current (:) Lines as set since the last render. string_type rather than character(len=:), allocatable :: (:) for two reasons, both learned the hard way. A deferred-length allocatable array cannot be blanked with a\nwhole-array = \"\" : F2018 10.2.1.3 deallocates and reallocates an\nallocatable whose length type parameter differs from the\nexpression’s, so that assignment sets the length to zero. GNU,\nAOCC and LFortran keep the length and blank-pad; Intel and NVIDIA\nreallocate. Both readings are defensible and the construct is\ntherefore unusable here. And a fixed row length has to be guessed. Escape sequences make a\nstyled line far longer in bytes than in columns – per-character\ncolouring runs to about ten bytes a column – so any constant\nmultiple of the width is a cap waiting to truncate someone’s row. logical, private :: full_redraw = .true. Set by resize and invalidate ; makes the next render emit every\nrow regardless of the diff. integer(kind=default_int), private :: rows = 0_default_int Number of lines. type( string_type ), private, allocatable :: shown (:) Lines as of the last render, for diffing. Type-Bound Procedures procedure, public :: col_count => frame_col_count private pure function frame_col_count (this) result(c) Width the frame truncates to. Arguments Type Intent Optional Attributes Name class( frame_t ), intent(in) :: this Return Value integer(kind=default_int) procedure, public :: invalidate => frame_invalidate private  subroutine frame_invalidate (this) Force the next render to emit every row. Read more… Arguments Type Intent Optional Attributes Name class( frame_t ), intent(inout) :: this procedure, public :: render => frame_render private  function frame_render (this) result(output) The escape sequence that brings the screen up to date. Read more… Arguments Type Intent Optional Attributes Name class( frame_t ), intent(inout) :: this Return Value character(len=:), allocatable procedure, public :: resize => frame_resize private  subroutine frame_resize (this, rows, cols) Set the frame’s dimensions, discarding the diff. Read more… Arguments Type Intent Optional Attributes Name class( frame_t ), intent(inout) :: this integer(kind=default_int), intent(in) :: rows Number of lines; below 0 is treated as 0. integer(kind=default_int), intent(in) :: cols Width in code points; below 0 is treated as 0. procedure, public :: row_count => frame_row_count private pure function frame_row_count (this) result(r) Number of lines the frame holds. Arguments Type Intent Optional Attributes Name class( frame_t ), intent(in) :: this Return Value integer(kind=default_int) procedure, public :: set_line => frame_set_line private  subroutine frame_set_line (this, row, text) Set one line, truncated to the frame width in code points. Read more… Arguments Type Intent Optional Attributes Name class( frame_t ), intent(inout) :: this integer(kind=default_int), intent(in) :: row One-based row. character(len=*), intent(in) :: text Text for the row. Source Code type :: frame_t !! A screen's worth of text lines, rendered by diffing against the last. !! !! The model is \"set every line, render, repeat\". `render` compares each !! line with what was last rendered and emits moves and rewrites only !! for the rows that changed, so an otherwise idle board that updates a !! clock writes one line rather than twenty-four. That is what makes the !! simple model flicker-free. private type ( string_type ), allocatable :: current (:) !! Lines as set since the last render. !! !! `string_type` rather than `character(len=:), allocatable :: (:)` !! for two reasons, both learned the hard way. !! !! A deferred-length allocatable *array* cannot be blanked with a !! whole-array `= \"\"`: F2018 10.2.1.3 deallocates and reallocates an !! allocatable whose length type parameter differs from the !! expression's, so that assignment sets the length to zero. GNU, !! AOCC and LFortran keep the length and blank-pad; Intel and NVIDIA !! reallocate. Both readings are defensible and the construct is !! therefore unusable here. !! !! And a fixed row length has to be guessed. Escape sequences make a !! styled line far longer in bytes than in columns -- per-character !! colouring runs to about ten bytes a column -- so any constant !! multiple of the width is a cap waiting to truncate someone's row. type ( string_type ), allocatable :: shown (:) !! Lines as of the last render, for diffing. integer ( default_int ) :: rows = 0_default_int !! Number of lines. integer ( default_int ) :: cols = 0_default_int !! Width in code points; `set_line` truncates to it. logical :: full_redraw = . true . !! Set by `resize` and `invalidate`; makes the next render emit every !! row regardless of the diff. contains procedure :: resize => frame_resize procedure :: set_line => frame_set_line procedure :: render => frame_render procedure :: invalidate => frame_invalidate procedure :: row_count => frame_row_count procedure :: col_count => frame_col_count end type frame_t","tags":"","url":"type/frame_t.html"},{"title":"key_event_t – PIC ","text":"type, public :: key_event_t One decoded key press. Components Type Visibility Attributes Name Initial integer(kind=int32), public :: char_code = 0_int32 Byte value, meaningful when code is KEY_CHAR . integer(kind=int32), public :: code = KEY_NONE One of the KEY_* codes. Source Code type :: key_event_t !! One decoded key press. integer ( int32 ) :: code = KEY_NONE !! One of the KEY_* codes. integer ( int32 ) :: char_code = 0_int32 !! Byte value, meaningful when `code` is `KEY_CHAR`. end type key_event_t","tags":"","url":"type/key_event_t.html"},{"title":"pending_t – PIC ","text":"type, public :: pending_t Bytes of an escape sequence that arrived without their continuation. A terminal is free to split ESC [ A across two reads, and a decoder\nthat forgot the ESC between calls would report a stray escape and\nthen the letter A. This carries the fragment across. Components Type Visibility Attributes Name Initial character(len=PENDING_CAPACITY), private :: buffer = \"\" Fixed store, so a pending_t needs no allocation and can be a\nplain component of a caller’s state. integer(kind=default_int), private :: length = 0_default_int Bytes in use. Type-Bound Procedures procedure, public :: clear => pending_clear private pure subroutine pending_clear (this) Forget any partial escape sequence. Arguments Type Intent Optional Attributes Name class( pending_t ), intent(inout) :: this procedure, public :: is_empty => pending_is_empty private pure function pending_is_empty (this) result(r) Whether a partial sequence is being carried. Arguments Type Intent Optional Attributes Name class( pending_t ), intent(in) :: this Return Value logical Source Code type :: pending_t !! Bytes of an escape sequence that arrived without their continuation. !! !! A terminal is free to split `ESC [ A` across two reads, and a decoder !! that forgot the `ESC` between calls would report a stray escape and !! then the letter A. This carries the fragment across. private character ( len = PENDING_CAPACITY ) :: buffer = \"\" !! Fixed store, so a `pending_t` needs no allocation and can be a !! plain component of a caller's state. integer ( default_int ) :: length = 0_default_int !! Bytes in use. contains procedure :: clear => pending_clear procedure :: is_empty => pending_is_empty end type pending_t","tags":"","url":"type/pending_t.html"},{"title":"pcg32_next_exponential_dp – PIC","text":"private  function pcg32_next_exponential_dp(gen, mean) result(r) Exponential deviate from a PCG32 generator. Arguments Type Intent Optional Attributes Name type( pcg32_t ), intent(inout) :: gen Generator, advanced by one draw. real(kind=dp), intent(in) :: mean Mean of the distribution. Return Value real(kind=dp) Calls proc~~pcg32_next_exponential_dp~~CallsGraph proc~pcg32_next_exponential_dp pcg32_next_exponential_dp interface~next_real_dp next_real_dp proc~pcg32_next_exponential_dp->interface~next_real_dp proc~pcg32_next_real_dp pcg32_next_real_dp interface~next_real_dp->proc~pcg32_next_real_dp proc~splitmix64_next_real_dp splitmix64_next_real_dp interface~next_real_dp->proc~splitmix64_next_real_dp proc~pcg32_next_u64 pcg32_t%pcg32_next_u64 proc~pcg32_next_real_dp->proc~pcg32_next_u64 proc~real_from_word real_from_word proc~pcg32_next_real_dp->proc~real_from_word proc~splitmix64_next_real_dp->proc~real_from_word proc~splitmix64_next_u64 splitmix64_t%splitmix64_next_u64 proc~splitmix